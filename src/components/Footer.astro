---
import Icon from './Icon.astro';
import { org, branches, circle } from '~/data/site';
import { formatDigits, localizePath, telHref, useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = (path: string) => localizePath(path, lang);
const central = branches[0];
const facebookPages = branches.filter((b) => b.facebook);

const explore = [
  { path: '/services', label: t('nav.services') },
  { path: '/about', label: t('nav.aboutUs') },
  { path: '/team', label: t('nav.team') },
  { path: '/impact', label: t('nav.impact') },
  { path: '/news', label: t('nav.news') },
];
const help = [
  { path: '/contact', label: t('nav.contact') },
  { path: '/faq', label: t('nav.faq') },
  { path: '/resources', label: t('nav.resources') },
  { path: '/careers', label: t('nav.careers') },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href={href('/')}>
        <span class="brand-logo"><img src="/images/logo-96.webp" alt="" width="48" height="48" loading="lazy" /></span>
        <span class="brand-name">{org.legalName[lang]}</span>
      </a>
      <p class="about">{t('footer.about')}</p>
      <ul class="contact-list">
        <li>
          <Icon name="map-pin" size={18} />
          <span>{central.address[lang]}</span>
        </li>
        <li>
          <Icon name="phone" size={18} />
          <span>
            {
              central.phones.map((p, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={telHref(p)}>{p}</a>
                </>
              ))
            }
          </span>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <a href={`mailto:${org.email}`}>{org.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="footer-title">{t('footer.explore')}</h2>
      <ul class="link-list">
        {explore.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer-title">{t('footer.help')}</h2>
      <ul class="link-list">
        {help.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
        <li>
          <a href={org.chatUrl} target="_blank" rel="noopener">{t('cta.chat')}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="footer-title">{t('footer.circle')}</h2>
      <ul class="link-list">
        {
          circle.map((c) => (
            <li>{c.href ? <a href={c.href} target="_blank" rel="noopener">{c.name[lang]}</a> : <span>{c.name[lang]}</span>}</li>
          ))
        }
      </ul>
      <div class="social">
        {
          facebookPages.map((b) => (
            <a href={b.facebook} target="_blank" rel="noopener" aria-label={`${t('common.facebook')} — ${b.name[lang]}`} title={b.name[lang]}>
              <Icon name="facebook" size={18} />
            </a>
          ))
        }
        <a href={`https://www.youtube.com/watch?v=${org.youtubeVideoId}`} target="_blank" rel="noopener" aria-label="YouTube">
          <Icon name="youtube" size={18} />
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      © {formatDigits(year, lang)} {org.legalName[lang]}. {t('footer.rights')}
      <a class="staff" href="/admin/login" rel="nofollow">{t('footer.staff')}</a>
    </p>
    <p class="slogan">“{org.slogan[lang]}”</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-top: clamp(3.5rem, 7vw, 5rem);
    background:
      radial-gradient(800px 300px at 10% 0%, rgb(69 154 46 / 0.28), transparent 65%),
      linear-gradient(170deg, var(--slate-700), var(--slate-900));
    color: #c9ccd6;
    font-size: 0.98rem;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(to right, var(--green-bright), var(--green), var(--yellow));
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.6fr repeat(3, 1fr);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    text-decoration: none;
  }

  .brand-logo {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
  }

  .brand-logo :global(img) {
    width: 48px;
    height: 48px;
  }

  .brand-name {
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .about {
    max-width: 30rem;
    margin-top: 1rem;
  }

  .contact-list,
  .link-list {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .contact-list :global(.icon) {
    flex: none;
    margin-top: 0.25em;
    color: var(--yellow);
  }

  .site-footer a {
    color: #eef0f5;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--yellow);
    text-decoration: underline;
  }

  .footer-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  :global(:lang(ne)) .footer-title {
    font-size: 1rem;
    letter-spacing: 0;
  }

  .link-list {
    margin-top: 1rem;
  }

  .social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    transition: background-color 0.2s;
  }

  .social a:hover {
    background: var(--green);
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.9rem;
    color: #a4a8b5;
  }

  .slogan {
    font-style: italic;
  }

  /* For office staff only, so it stays quiet: same color as the copyright line, no underline. */
  .staff {
    margin-inline-start: 0.5rem;
    color: inherit;
    font-size: 0.8rem;
    text-decoration: none;
    opacity: 0.7;
  }

  .staff:hover,
  .staff:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }
</style>
