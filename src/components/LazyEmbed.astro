---
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Props = {
  src: string;
  title: string;
  buttonLabel: string;
  note?: string;
  icon?: IconName | 'facebook';
  height?: string;
};
const { src, title, buttonLabel, note, icon = 'map', height = '380px' } = Astro.props;
---

<div class="lazy-embed" data-embed={src} data-title={title} style={`--embed-h: ${height}`}>
  <div class="placeholder">
    <span class="icon-tile lg"><Icon name={icon} size={26} /></span>
    {note && <p class="small muted">{note}</p>}
    <button class="btn btn-ghost btn-sm" type="button">{buttonLabel}</button>
  </div>
</div>

<script>
  // Third-party frames (maps, Facebook, Drive) load only on request:
  // faster pages, fewer trackers, less data for visitors on mobile.
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.embed ?? '';
      iframe.title = box.dataset.title ?? '';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(iframe);
      box.classList.add('loaded');
    });
  });
</script>

<style>
  .lazy-embed {
    display: grid;
    height: var(--embed-h);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 1px 1px, var(--green-100) 1px, transparent 0) 0 0 / 18px 18px,
      var(--green-50);
  }

  .lazy-embed :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }
</style>
