---
import Icon from './Icon.astro';
import type { IconName } from './icons';

/**
 * Third-party frame (Google Maps, Google Drive, Facebook) that loads by itself.
 * `loading="lazy"` lets the browser fetch it only as it nears the screen, so pages
 * stay fast; a placeholder shows until the frame has loaded.
 */
type Props = {
  src: string;
  title: string;
  icon?: IconName | 'facebook';
  height?: string;
};
const { src, title, icon = 'map', height = '380px' } = Astro.props;
---

<div class="embed" style={`--embed-h: ${height}`} data-embed>
  <div class="placeholder" aria-hidden="true">
    <span class="icon-tile lg"><Icon name={icon} size={26} /></span>
    <span class="dots"><span></span><span></span><span></span></span>
  </div>
  <iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>

<script>
  // Hide the placeholder once the frame has content (it stays hidden behind the frame otherwise).
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((box) => {
    box.querySelector('iframe')?.addEventListener('load', () => box.classList.add('loaded'), { once: true });
  });
</script>

<style>
  .embed {
    position: relative;
    height: var(--embed-h);
    min-height: 280px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 1px 1px, var(--green-100) 1px, transparent 0) 0 0 / 18px 18px,
      var(--green-50);
  }

  .embed iframe {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    transition: opacity 0.3s;
  }

  .loaded .placeholder {
    opacity: 0;
  }

  .dots {
    display: flex;
    gap: 0.35rem;
  }

  .dots span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--green);
    opacity: 0.35;
    animation: pulse 1.2s infinite ease-in-out;
  }

  .dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes pulse {
    50% {
      opacity: 1;
    }
  }
</style>
