---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  Site-wide notice managed in /admin/notices. Loaded from /api/notice.json (cached at the edge)
  so pre-rendered pages pick up new notices without rebuilding the site.
-->
<div class="notice-bar" data-notice data-lang={lang} role="region" aria-label={t('notice.label')} hidden>
  <div class="container inner">
    <span class="badge" data-notice-badge>
      <Icon name="megaphone" size={16} />
      {t('notice.label')}
    </span>
    <p class="text">
      <span data-notice-text></span>
      <a class="more" data-notice-link hidden>
        {t('notice.more')}
        <Icon name="arrow-right" size={14} />
      </a>
    </p>
    <button class="close" type="button" data-notice-close aria-label={t('notice.dismiss')}>
      <Icon name="x" size={18} />
    </button>
  </div>
</div>

<script>
  type NoticePayload = {
    id: number;
    tone: 'info' | 'warning' | 'urgent';
    message: { en: string; ne: string };
    link: string | null;
    endsAt: string | null;
  };

  const bar = document.querySelector<HTMLElement>('[data-notice]');
  if (bar) {
    fetch('/api/notice.json')
      .then((res) => (res.ok ? res.json() : null))
      .then((data: { notice: NoticePayload | null } | null) => {
        const notice = data?.notice;
        if (!notice) return;
        if (notice.endsAt && Date.parse(notice.endsAt) <= Date.now()) return;
        const key = `notice-dismissed-${notice.id}`;
        try {
          if (sessionStorage.getItem(key)) return;
        } catch {}

        const lang = bar.dataset.lang;
        const text = lang === 'ne' ? notice.message.ne || notice.message.en : notice.message.en || notice.message.ne;
        bar.querySelector('[data-notice-text]')!.textContent = text;

        const link = bar.querySelector<HTMLAnchorElement>('[data-notice-link]')!;
        if (notice.link) {
          const isInternal = notice.link.startsWith('/');
          link.href = isInternal && lang === 'ne' && !notice.link.startsWith('/ne/') ? `/ne${notice.link}` : notice.link;
          if (!isInternal) link.rel = 'noopener';
          link.hidden = false;
        }

        bar.dataset.tone = notice.tone;
        bar.hidden = false;
        bar.querySelector('[data-notice-close]')?.addEventListener('click', () => {
          bar.hidden = true;
          try {
            sessionStorage.setItem(key, '1');
          } catch {}
        });
      })
      .catch(() => {});
  }
</script>

<style>
  .notice-bar {
    --tone-bg: var(--navy);
    --tone-fg: #fff;
    --tone-badge-bg: rgb(255 255 255 / 0.16);
    --tone-badge-fg: #fff;
    background: var(--tone-bg);
    color: var(--tone-fg);
    animation: slide-down 0.35s var(--ease);
  }

  .notice-bar[data-tone='warning'] {
    --tone-bg: var(--yellow);
    --tone-fg: var(--green-900);
    --tone-badge-bg: var(--green-900);
    --tone-badge-fg: var(--yellow);
  }

  .notice-bar[data-tone='urgent'] {
    --tone-bg: #9b1c1c;
    --tone-badge-bg: #fff;
    --tone-badge-fg: #9b1c1c;
  }

  .inner {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.5rem;
  }

  .badge {
    display: inline-flex;
    flex: none;
    gap: 0.35rem;
    align-items: center;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--tone-badge-bg);
    color: var(--tone-badge-fg);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .text {
    flex: 1;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .more {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    margin-inline-start: 0.5rem;
    color: inherit;
    font-weight: 700;
    white-space: nowrap;
  }

  .more:hover {
    color: inherit;
  }

  .close {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .close:hover {
    background: rgb(0 0 0 / 0.12);
  }

  @media (max-width: 560px) {
    .badge {
      display: none;
    }
  }

  @keyframes slide-down {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
  }
</style>
