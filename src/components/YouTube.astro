---
import Icon from './Icon.astro';

type Props = { id: string; title: string; label: string };
const { id, title, label } = Astro.props;
---

<div class="yt" data-yt={id} data-title={title}>
  <button class="yt-poster" type="button" aria-label={`${label}: ${title}`}>
    <span class="yt-pattern" aria-hidden="true"></span>
    <span class="yt-play"><Icon name="play" size={30} strokeWidth={2} /></span>
    <span class="yt-meta">
      <span class="yt-label"><Icon name="youtube" size={16} /> {label}</span>
      <span class="yt-title">{title}</span>
    </span>
  </button>
</div>

<script>
  // The YouTube player (≈1 MB) loads only after a click.
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--green-900);
    box-shadow: var(--shadow-lg);
  }

  .yt :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-poster {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 0;
    border: 0;
    color: #fff;
    text-align: start;
    cursor: pointer;
    background:
      radial-gradient(500px 260px at 20% 20%, rgb(255 228 31 / 0.18), transparent 60%),
      linear-gradient(135deg, var(--green-bright), var(--green-700) 55%, var(--slate));
  }

  .yt-pattern {
    position: absolute;
    inset: 0;
    background-image:
      repeating-radial-gradient(circle at 110% 120%, rgb(255 255 255 / 0.08) 0 2px, transparent 2px 28px);
  }

  .yt-play {
    position: relative;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--green-900);
    box-shadow: 0 0 0 12px rgb(255 228 31 / 0.2);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .yt-play :global(svg) {
    margin-left: 4px;
    fill: currentColor;
  }

  .yt-poster:hover .yt-play {
    transform: scale(1.08);
    box-shadow: 0 0 0 18px rgb(255 228 31 / 0.18);
  }

  .yt-meta {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.25rem;
    display: grid;
    gap: 0.2rem;
  }

  .yt-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--yellow);
    font-weight: 600;
  }

  .yt-title {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.3rem);
    line-height: 1.3;
  }
</style>
