---
/**
 * Columns for one count per period (single series, so no legend: the card title names it).
 * The highest and the latest columns carry direct labels; every column has a hover/focus
 * tooltip, and the table view lists all values.
 */
export type Point = { label: string; value: number; tip: string };
type Props = {
  points: Point[];
  caption: string;
  unit: [string, string];
  tableHead: [string, string];
  /** Show every n-th x-axis label, counting back from the latest. */
  labelEvery?: number;
};
const { points, caption, unit, tableHead, labelEvery = 3 } = Astro.props;

const max = Math.max(0, ...points.map((p) => p.value));
// A clean top for the scale: 1–5 → 5, then 10, 20, 50…
const niceTop = (v: number) => {
  if (v <= 5) return 5;
  const pow = 10 ** Math.floor(Math.log10(v));
  const step = [1, 2, 5, 10].find((s) => s * pow >= v)!;
  return step * pow;
};
const top = niceTop(max);
const ticks = [top, top / 2, 0];
const count = (n: number) => `${n.toLocaleString('en')} ${n === 1 ? unit[0] : unit[1]}`;
const highest = points.findIndex((p) => p.value === max && max > 0);
const last = points.length - 1;
---

<figure class="columns-chart" style={`--n: ${points.length}`}>
  <figcaption class="visually-hidden">{caption}</figcaption>
  <div class="plot" aria-hidden="true">
    <div class="grid">
      {ticks.map((t) => <span class="tick" style={`--y: ${(t / top) * 100}%`}><span class="tick-label">{t.toLocaleString('en')}</span></span>)}
    </div>
    <ol class="bars">
      {
        points.map((p, i) => (
          <li class="col" tabindex="0" aria-label={`${p.tip}: ${count(p.value)}`}>
            <span class="bar-slot">
              {(i === highest || i === last) && p.value > 0 && <span class="value">{p.value.toLocaleString('en')}</span>}
              <span class:list={['bar', { current: i === last, empty: p.value === 0 }]} style={`--h: ${(p.value / top) * 100}%`} />
            </span>
            <span class="tip" role="presentation">
              <strong>{count(p.value)}</strong>
              <span>{p.tip}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <ol class="x-labels" aria-hidden="true">
    {points.map((p, i) => <li class:list={{ show: (last - i) % labelEvery === 0 }}>{p.label}</li>)}
  </ol>
  <details class="table-view">
    <summary>View as table</summary>
    <table>
      <caption class="visually-hidden">{caption}</caption>
      <thead>
        <tr><th scope="col">{tableHead[0]}</th><th scope="col">{tableHead[1]}</th></tr>
      </thead>
      <tbody>
        {points.map((p) => <tr><th scope="row">{p.tip}</th><td class="nums">{p.value.toLocaleString('en')}</td></tr>)}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .columns-chart {
    display: grid;
    gap: 0.4rem;
    margin: 0;
  }

  .plot {
    position: relative;
    height: 11rem;
    margin-left: 1.75rem;
  }

  .grid {
    position: absolute;
    inset: 0;
  }

  .tick {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--y);
    border-top: 1px solid #e6e9e4;
  }

  .tick-label {
    position: absolute;
    right: calc(100% + 0.4rem);
    top: -0.55rem;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .bars {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col {
    position: relative;
    display: flex;
    justify-content: center;
    outline: none;
    cursor: default;
  }

  .bar-slot {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: min(24px, 70%);
    height: 100%;
  }

  .bar {
    width: 100%;
    height: var(--h);
    min-height: 2px;
    border-radius: 4px 4px 0 0;
    background: #459a2e;
    opacity: 0.55;
    transition: opacity 0.15s;
  }

  .bar.current {
    opacity: 1;
  }

  .bar.empty {
    background: #d9ded6;
    opacity: 1;
  }

  .value {
    margin-bottom: 0.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink);
  }

  .col:hover .bar,
  .col:focus-visible .bar {
    opacity: 1;
  }

  .col:focus-visible .bar-slot {
    outline: 2px solid var(--green-700);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .tip {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 50%;
    z-index: 2;
    display: none;
    gap: 0.1rem;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    background: var(--ink, #1f2a24);
    color: #fff;
    font-size: 0.78rem;
    white-space: nowrap;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .col:hover .tip,
  .col:focus-visible .tip {
    display: grid;
  }

  .col:first-child .tip {
    left: 0;
    transform: none;
  }

  .col:last-child .tip {
    left: auto;
    right: 0;
    transform: none;
  }

  .x-labels {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0 0 0 1.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: var(--muted);
    text-align: center;
  }

  .x-labels li:not(.show) {
    visibility: hidden;
  }

  .table-view summary {
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--green-700);
  }

  .table-view table {
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .table-view th,
  .table-view td {
    padding: 0.2rem 0.75rem 0.2rem 0;
    text-align: start;
    font-weight: 400;
  }

  .nums {
    font-variant-numeric: tabular-nums;
  }
</style>
