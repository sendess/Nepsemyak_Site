---
import type { Share } from '~/lib/dashboard';

/** Horizontal bars for one breakdown (single series): label, bar, count and share. Rows link when `href` is given. */
type Props = { items: Share[]; caption: string; href?: (key: string) => string; empty?: string };
const { items, caption, href, empty = 'Nothing yet.' } = Astro.props;
const total = items.reduce((sum, i) => sum + i.value, 0);
const max = Math.max(1, ...items.map((i) => i.value));
const pct = (v: number) => (total ? Math.round((v / total) * 100) : 0);
---

<figure class="shares">
  <figcaption class="visually-hidden">{caption}</figcaption>
  {
    items.length === 0 ? (
      <p class="hint">{empty}</p>
    ) : (
      <ul role="list">
        {items.map((item) => {
          const Tag = href ? 'a' : 'div';
          return (
            <li>
              <Tag class="row" href={href?.(item.key)} title={`${item.label}: ${item.value} (${pct(item.value)}%)`}>
                <span class="label">{item.label}</span>
                <span class="track" aria-hidden="true">
                  <span class="bar" style={`--w: ${Math.max((item.value / max) * 100, 2)}%`} />
                </span>
                <span class="value">
                  {item.value} <small>{pct(item.value)}%</small>
                </span>
              </Tag>
            </li>
          );
        })}
      </ul>
    )
  }
</figure>

<style>
  .shares {
    margin: 0;
  }

  ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr) 4.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.15rem 0.25rem;
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
  }

  a.row:hover,
  a.row:focus-visible {
    background: var(--green-50);
  }

  .label {
    overflow: hidden;
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track {
    height: 0.6rem;
  }

  .bar {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 0 4px 4px 0;
    background: #459a2e;
  }

  .value {
    font-weight: 700;
    font-size: 0.9rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .value small {
    font-weight: 400;
    color: var(--muted);
  }
</style>
