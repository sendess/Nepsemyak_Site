---
/** Previous / next topic at the end of a help page, so a new person can read the guides in order. */
import Icon from '~/components/Icon.astro';
import { HELP } from '~/lib/admin-routes';
import { topicHref, topicTitle, type HelpLang, type HelpTopic } from '~/lib/help';

type Props = { prev: HelpTopic | null; next: HelpTopic | null; isTopic: boolean; lang?: HelpLang };
const { prev, next, isTopic, lang = 'en' } = Astro.props;
const text =
  lang === 'ne'
    ? { prev: 'अघिल्लो', next: 'अर्को', all: 'सबै विषय', print: 'यो पृष्ठ प्रिन्ट गर्नुहोस्' }
    : { prev: 'Previous', next: 'Next', all: 'All help topics', print: 'Print this page' };
---

<footer class="help-foot">
  {
    isTopic && (
      <div class="pager">
        {prev ? (
          <a class="step-link" href={topicHref(prev.slug)}>
            <small>{text.prev}</small>
            <span>
              <Icon name="arrow-left" size={14} /> {topicTitle(prev, lang)}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="step-link next" href={topicHref(next.slug)}>
            <small>{text.next}</small>
            <span>
              {topicTitle(next, lang)} <Icon name="arrow-right" size={14} />
            </span>
          </a>
        )}
      </div>
    )
  }
  <p class="foot-links">
    {isTopic && <a href={HELP}>{text.all}</a>}
    <button class="link-button" type="button" data-print>{text.print}</button>
  </p>
</footer>

<style>
  .help-foot {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .step-link {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .step-link:hover,
  .step-link:focus-visible {
    border-color: var(--green);
  }

  .step-link.next {
    text-align: end;
  }

  .step-link small {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .step-link span {
    font-weight: 600;
    color: var(--green-700);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    font-size: 0.9rem;
  }

  .link-button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--green-700);
    text-decoration: underline;
    cursor: pointer;
  }

  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .step-link.next {
      text-align: start;
    }
  }
</style>
