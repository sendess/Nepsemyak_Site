---
/** "On this page" links to a help topic's sub-sections; labels are help text keys. */
import type { HelpKey } from '~/lib/help-text';

type Props = { items: { id: string; k: HelpKey; show?: boolean }[] };
const t = Astro.locals.helpText!;
const items = Astro.props.items.filter((i) => i.show !== false);
---

<nav aria-label={t.text('shell.onThisPage')}>
  <ul class="toc">
    {
      items.map((i) => (
        <li>
          <a href={`#${i.id}`}>{t.text(i.k)}</a>
        </li>
      ))
    }
  </ul>
</nav>
