---
import Toc from '../Toc.astro';
import { can } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const isMaster = can(reader, 'files');

// One section per part of the website; each lists its lines in order.
const sections: { id: string; toc: HelpKey; intro?: HelpKey; items: HelpKey[] }[] = [
  { id: 'basics', toc: 'content.toc.basics', items: ['content.basics.1', 'content.basics.2', 'content.basics.3', 'content.basics.4'] },
  {
    id: 'notices',
    toc: 'content.toc.notices',
    intro: 'content.notices.intro',
    items: ['content.notices.1', 'content.notices.2', 'content.notices.3', 'content.notices.4', 'content.notices.5'],
  },
  { id: 'news', toc: 'content.toc.news', items: ['content.news.1', 'content.news.2', 'content.news.3', 'content.news.4', 'content.news.5'] },
  { id: 'jobs', toc: 'content.toc.jobs', items: ['content.jobs.1', 'content.jobs.2', 'content.jobs.3'] },
  { id: 'statistics', toc: 'content.toc.stats', items: ['content.stats.1', 'content.stats.2', 'content.stats.3', 'content.stats.4', 'content.stats.5'] },
  { id: 'pages', toc: 'content.toc.pages', items: ['content.pages.1', 'content.pages.2', 'content.pages.3', 'content.pages.4'] },
  {
    id: 'photos',
    toc: 'content.toc.photos',
    items: ['content.photos.1', 'content.photos.2', 'content.photos.3', isMaster ? 'content.photos.4master' : 'content.photos.4'],
  },
  { id: 'writing', toc: 'content.toc.writing', items: ['content.writing.1', 'content.writing.2', 'content.writing.3', 'content.writing.4'] },
];
---

<Toc items={sections.map((s) => ({ id: s.id, k: s.toc }))} />

{
  sections.map((s) => (
    <section id={s.id} aria-labelledby={`${s.id}-h`}>
      <h2 id={`${s.id}-h`}>{t.text(s.toc)}</h2>
      {s.intro && <p set:html={t.html(s.intro)} />}
      <ul class="plain">
        {s.items.map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ul>
    </section>
  ))
}
