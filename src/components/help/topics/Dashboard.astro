---
import Toc from '../Toc.astro';
import { can } from '~/lib/roles';
import { readerOffice, type HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const handles = can(reader, 'requests.handle');
const content = can(reader, 'content');
const visitors = can(reader, 'visitors');
const isMaster = can(reader, 'people');
const office = readerOffice(reader, t.lang);

const figures: [name: HelpKey, meaning: HelpKey][] = [
  ['dashboard.figures.waiting', 'dashboard.figures.waitingText'],
  ['dashboard.figures.month', 'dashboard.figures.monthText'],
  ['dashboard.figures.reply', 'dashboard.figures.replyText'],
  ['dashboard.figures.resolved', 'dashboard.figures.resolvedText'],
  ['dashboard.figures.weekly', 'dashboard.figures.weeklyText'],
  ['dashboard.figures.topics', office ? 'dashboard.figures.topicsTextOffice' : 'dashboard.figures.topicsText'],
  ['dashboard.figures.workload', 'dashboard.figures.workloadText'],
];
---

<Toc
  items={[
    { id: 'attention', k: 'dashboard.toc.attention', show: handles || content },
    { id: 'query-figures', k: 'dashboard.toc.figures' },
    { id: 'visitors', k: 'dashboard.toc.visitors', show: visitors },
    { id: 'on-the-website', k: 'dashboard.toc.website', show: content },
    { id: 'team', k: 'dashboard.toc.team', show: isMaster },
    { id: 'reading-charts', k: 'dashboard.toc.charts' },
  ]}
/>

<p set:html={t.html('dashboard.intro')} />

{
  (handles || content) && (
    <section id="attention" aria-labelledby="attention-h">
      <h2 id="attention-h">{t.text('dashboard.toc.attention')}</h2>
      <p set:html={t.html('dashboard.attention.intro')} />
      <ul class="plain">
        {handles && <li set:html={office ? t.html('dashboard.attention.queriesOffice', { office }) : t.html('dashboard.attention.queries')} />}
        {handles && <li set:html={t.html('dashboard.attention.mine')} />}
        {content && <li set:html={t.html('dashboard.attention.content')} />}
        <li set:html={t.html('dashboard.attention.codes')} />
        {isMaster && <li set:html={t.html('dashboard.attention.master')} />}
      </ul>
    </section>
  )
}

<section id="query-figures" aria-labelledby="query-figures-h">
  <h2 id="query-figures-h">{t.text('dashboard.toc.figures')}</h2>
  {office && <p class="callout" set:html={t.html('dashboard.figures.office', { office })} />}
  <div class="table-wrap">
    <table class="wide-cells">
      <thead>
        <tr>
          <th scope="col">{t.text('dashboard.figures.colFigure')}</th>
          <th scope="col">{t.text('dashboard.figures.colMeaning')}</th>
        </tr>
      </thead>
      <tbody>
        {
          figures.map(([name, meaning]) => (
            <tr>
              <th scope="row">{t.text(name)}</th>
              <td set:html={t.html(meaning)} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

{
  visitors && (
    <section id="visitors" aria-labelledby="visitors-h">
      <h2 id="visitors-h">{t.text('dashboard.toc.visitors')}</h2>
      <p set:html={t.html('dashboard.visitors.intro')} />
      <ul class="plain">
        {(['dashboard.visitors.1', 'dashboard.visitors.2', 'dashboard.visitors.3', 'dashboard.visitors.4', 'dashboard.visitors.5'] as const).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ul>
    </section>
  )
}

{
  content && (
    <section id="on-the-website" aria-labelledby="website-h">
      <h2 id="website-h">{t.text('dashboard.toc.website')}</h2>
      <p set:html={t.html('dashboard.website.text')} />
    </section>
  )
}

{
  isMaster && (
    <section id="team" aria-labelledby="team-h">
      <h2 id="team-h">{t.text('dashboard.toc.team')}</h2>
      <ul class="plain">
        {(['dashboard.team.1', 'dashboard.team.2', 'dashboard.team.3', 'dashboard.team.4'] as const).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ul>
    </section>
  )
}

<section id="reading-charts" aria-labelledby="charts-h">
  <h2 id="charts-h">{t.text('dashboard.toc.charts')}</h2>
  <ul class="plain">
    {(['dashboard.charts.1', 'dashboard.charts.2', 'dashboard.charts.3'] as const).map((k) => <li set:html={t.html(k)} />)}
  </ul>
</section>
