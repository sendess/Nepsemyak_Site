---
import Toc from '../Toc.astro';
import Check from '../Check.astro';
import { can, type Permission } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;

// The menu as this person sees it. Menu names stay in English, as in the panel.
const menu: { label: string; k: HelpKey; need?: Permission }[] = [
  { label: 'Dashboard', k: 'start.menu.dashboard' },
  { label: 'Requests', k: 'start.menu.requests', need: 'requests.view' },
  { label: 'Notices', k: 'start.menu.notices', need: 'content' },
  { label: 'Statistics', k: 'start.menu.stats', need: 'content' },
  { label: 'News', k: 'start.menu.news', need: 'content' },
  { label: 'Jobs', k: 'start.menu.jobs', need: 'content' },
  { label: 'Pages', k: 'start.menu.pages', need: 'content' },
  { label: 'Users', k: 'start.menu.users', need: 'people' },
  { label: 'Activity', k: 'start.menu.activity', need: 'activity' },
  { label: 'Files', k: 'start.menu.files', need: 'files' },
  { label: 'My account', k: 'start.menu.account' },
  { label: 'Help', k: 'start.menu.help' },
];
const myMenu = reader ? menu.filter((m) => !m.need || can(reader, m.need)) : [];
const youDo = ['start.first.y1', 'start.first.y2', 'start.first.y3', 'start.first.y4', 'start.first.y5', 'start.first.y6', 'start.first.y7', 'start.first.y8', 'start.first.y9'] as const;
---

<Toc
  items={[
    { id: 'before', k: 'start.toc.before' },
    { id: 'first-sign-in', k: 'start.toc.first' },
    { id: 'signing-in', k: 'start.toc.signin' },
    { id: 'find-your-way', k: 'start.toc.find', show: Boolean(reader) },
  ]}
/>

<section id="before" aria-labelledby="before-h">
  <h2 id="before-h">{t.text('start.toc.before')}</h2>
  <p set:html={t.html('start.before.intro')} />
  <ul class="checklist">
    <Check remember="pre-email" title="start.before.email" detail="start.before.emailDetail" />
    <Check remember="pre-phone" title="start.before.phone" detail="start.before.phoneDetail" />
    <Check remember="pre-clock" title="start.before.clock" detail="start.before.clockDetail" />
    <Check remember="pre-paper" title="start.before.paper" detail="start.before.paperDetail" />
    <Check remember="pre-browser" title="start.before.browser" detail="start.before.browserDetail" />
    <Check remember="pre-role" title="start.before.role" detail="start.before.roleDetail" />
  </ul>
</section>

<section id="first-sign-in" aria-labelledby="first-h">
  <h2 id="first-h">{t.text('start.toc.first')}</h2>
  <p set:html={t.html('start.first.intro')} />
  <p class="track">{t.text('start.first.masterDoes')}</p>
  <ol class="steps">
    <li set:html={t.html('start.first.m1')} />
    <li set:html={t.html('start.first.m2')} />
  </ol>
  <p class="track">{t.text('start.first.youDo')}</p>
  <ol class="steps">
    {youDo.map((k) => <li set:html={t.html(k)} />)}
  </ol>
</section>

<section id="signing-in" aria-labelledby="signing-h">
  <h2 id="signing-h">{t.text('start.toc.signin')}</h2>
  <p set:html={t.html('start.signin.text')} />
  <p class="callout warn" set:html={t.html('start.signin.warn')} />
</section>

{
  reader && (
    <section id="find-your-way" aria-labelledby="find-h">
      <h2 id="find-h">{t.text('start.toc.find')}</h2>
      <p set:html={t.html('start.find.intro')} />
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">{t.text('start.find.colMenu')}</th>
              <th scope="col">{t.text('start.find.colWhat')}</th>
            </tr>
          </thead>
          <tbody>
            {myMenu.map((m) => (
              <tr>
                <th scope="row" lang="en">
                  {m.label}
                </th>
                <td set:html={t.html(m.k)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
