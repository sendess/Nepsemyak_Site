---
import type { HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const t = Astro.locals.helpText!;

// Each term and its meaning; listed in the order of the terms in the reader's language.
const TERMS = [
  'asOf', 'assigned', 'authenticator', 'banner', 'bs', 'support', 'draft', 'editor', 'alert', 'master', 'note', 'office',
  'passed', 'pageView', 'popup', 'published', 'query', 'recovery', 'ref', 'restore', 'role', 'section', 'status', 'track',
  'twoStep', 'viewer', 'visit',
] as const;
const collator = new Intl.Collator(t.lang === 'ne' ? 'ne' : 'en');
const terms = TERMS.map((id) => ({ term: t.text(`glossary.${id}` as HelpKey), meaning: `glossary.${id}Text` as HelpKey }))
  .sort((a, b) => collator.compare(a.term.replace(/^[“"]/, ''), b.term.replace(/^[“"]/, '')));
---

<p set:html={t.html('glossary.intro')} />
<dl>
  {
    terms.map(({ term, meaning }) => (
      <div>
        <dt>{term}</dt>
        <dd set:html={t.html(meaning)} />
      </div>
    ))
  }
</dl>
