---
import Toc from '../Toc.astro';
import Check from '../Check.astro';
import type { HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const t = Astro.locals.helpText!;

const choosing: [person: HelpKey, give: HelpKey][] = [
  ['people.choosing.branch', 'people.choosing.branchGive'],
  ['people.choosing.head', 'people.choosing.headGive'],
  ['people.choosing.writer', 'people.choosing.writerGive'],
  ['people.choosing.manager', 'people.choosing.managerGive'],
];
// Service names stay as they are known.
const services: [service: string, what: HelpKey, who: HelpKey][] = [
  ['Google Authenticator', 'people.outside.authWhat', 'people.outside.authWho'],
  ['Netlify', 'people.outside.netlifyWhat', 'people.outside.netlifyWho'],
  ['Neon', 'people.outside.neonWhat', 'people.outside.neonWho'],
  ['Resend', 'people.outside.resendWhat', 'people.outside.resendWho'],
  ['Cloudflare Web Analytics', 'people.outside.cloudflareWhat', 'people.outside.cloudflareWho'],
  ['tawk.to', 'people.outside.tawkWhat', 'people.outside.tawkWho'],
];
---

<Toc
  items={[
    { id: 'choosing', k: 'people.toc.choosing' },
    { id: 'adding', k: 'people.toc.adding' },
    { id: 'changing', k: 'people.toc.changing' },
    { id: 'trouble', k: 'people.toc.trouble' },
    { id: 'leaving', k: 'people.toc.leaving' },
    { id: 'outside', k: 'people.toc.outside' },
    { id: 'locked-out', k: 'people.toc.locked' },
  ]}
/>

<section id="choosing" aria-labelledby="choosing-h">
  <h2 id="choosing-h">{t.text('people.toc.choosing')}</h2>
  <p set:html={t.html('people.choosing.intro')} />
  <div class="table-wrap">
    <table class="wide-cells">
      <thead>
        <tr>
          <th scope="col">{t.text('people.choosing.colPerson')}</th>
          <th scope="col">{t.text('people.choosing.colGive')}</th>
        </tr>
      </thead>
      <tbody>
        {
          choosing.map(([person, give]) => (
            <tr>
              <th scope="row">{t.text(person)}</th>
              <td set:html={t.html(give)} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p set:html={t.html('people.choosing.compare')} />
</section>

<section id="adding" aria-labelledby="adding-h">
  <h2 id="adding-h">{t.text('people.toc.adding')}</h2>
  <ol class="steps">
    {(['people.adding.1', 'people.adding.2', 'people.adding.3', 'people.adding.4', 'people.adding.5'] as const).map((k) => <li set:html={t.html(k)} />)}
  </ol>
  <p class="hint" set:html={t.html('people.adding.hint')} />
</section>

<section id="changing" aria-labelledby="changing-h">
  <h2 id="changing-h">{t.text('people.toc.changing')}</h2>
  <p set:html={t.html('people.changing.text')} />
</section>

<section id="trouble" aria-labelledby="trouble-h">
  <h2 id="trouble-h">{t.text('people.toc.trouble')}</h2>
  <ul class="plain">
    <li set:html={t.html('people.trouble.1')} />
    <li set:html={t.html('people.trouble.2')} />
  </ul>
</section>

<section id="leaving" aria-labelledby="leaving-h">
  <h2 id="leaving-h">{t.text('people.toc.leaving')}</h2>
  <p set:html={t.html('people.leaving.intro')} />
  <ul class="checklist">
    <Check remember="leave-remove" title="people.leaving.remove" detail="people.leaving.removeDetail" />
    <Check remember="leave-queries" title="people.leaving.queries" detail="people.leaving.queriesDetail" />
    <Check remember="leave-chat" title="people.leaving.chat" />
    <Check remember="leave-shared" title="people.leaving.shared" />
  </ul>
</section>

<section id="outside" aria-labelledby="outside-h">
  <h2 id="outside-h">{t.text('people.toc.outside')}</h2>
  <p set:html={t.html('people.outside.intro')} />
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t.text('people.outside.colService')}</th>
          <th scope="col">{t.text('people.outside.colWhat')}</th>
          <th scope="col">{t.text('people.outside.colWho')}</th>
        </tr>
      </thead>
      <tbody>
        {
          services.map(([service, what, who]) => (
            <tr>
              <th scope="row" lang="en">
                {service}
              </th>
              <td set:html={t.html(what)} />
              <td set:html={t.html(who)} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<section id="locked-out" aria-labelledby="locked-h">
  <h2 id="locked-h">{t.text('people.toc.locked')}</h2>
  <p set:html={t.html('people.locked.text')} />
</section>
