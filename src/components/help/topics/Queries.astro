---
import Toc from '../Toc.astro';
import { can } from '~/lib/roles';
import { readerOffice, type HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const handles = can(reader, 'requests.handle');
const canDelete = can(reader, 'requests.delete');
const office = readerOffice(reader, t.lang);
const li = (keys: readonly HelpKey[]) => keys;
// Status names stay in English, as they appear in the panel.
const statuses: [status: string, meaning: HelpKey, when: HelpKey][] = [
  ['New', 'queries.status.newMeaning', 'queries.status.newWhen'],
  ['In progress', 'queries.status.progressMeaning', 'queries.status.progressWhen'],
  ['Resolved', 'queries.status.resolvedMeaning', 'queries.status.resolvedWhen'],
  ['Spam', 'queries.status.spamMeaning', 'queries.status.spamWhen'],
];
const tracking: [status: string, sees: HelpKey][] = [
  ['New', 'queries.track.new'],
  ['In progress', 'queries.track.progress'],
  ['Resolved', 'queries.track.resolved'],
  ['Spam', 'queries.track.spam'],
];
---

<Toc
  items={[
    { id: 'where', k: 'queries.toc.where' },
    { id: 'your-list', k: 'queries.toc.list', show: Boolean(office) },
    { id: 'read-only', k: 'queries.toc.readOnly', show: !handles },
    { id: 'statuses', k: 'queries.toc.statuses' },
    { id: 'answering', k: 'queries.toc.answering', show: handles },
    { id: 'assigning', k: 'queries.toc.assigning', show: handles },
    { id: 'offices', k: 'queries.toc.offices', show: handles },
    { id: 'notes', k: 'queries.toc.notes', show: handles },
    { id: 'finding', k: 'queries.toc.finding' },
    { id: 'spam', k: 'queries.toc.spam', show: handles },
    { id: 'good-practice', k: 'queries.toc.good', show: handles },
    { id: 'tracking', k: 'queries.toc.tracking' },
  ]}
/>

<section id="where" aria-labelledby="where-h">
  <h2 id="where-h">{t.text('queries.toc.where')}</h2>
  <ul class="plain">
    <li set:html={t.html('queries.where.form')} />
    <li set:html={t.html('queries.where.ref')} />
    <li set:html={office ? t.html('queries.where.alertOffice', { office }) : t.html('queries.where.alert')} />
    <li set:html={t.html('queries.where.robots')} />
  </ul>
</section>

{
  office && (
    <section id="your-list" aria-labelledby="your-list-h">
      <h2 id="your-list-h">{t.text('queries.toc.list')}</h2>
      <p class="callout" set:html={t.html('queries.list.text', { office })} />
    </section>
  )
}

{
  !handles && (
    <section id="read-only" aria-labelledby="read-only-h">
      <h2 id="read-only-h">{t.text('queries.toc.readOnly')}</h2>
      <p set:html={t.html('queries.readOnly.text')} />
    </section>
  )
}

<section id="statuses" aria-labelledby="statuses-h">
  <h2 id="statuses-h">{t.text('queries.toc.statuses')}</h2>
  <div class="table-wrap">
    <table class="wide-cells">
      <thead>
        <tr>
          <th scope="col">{t.text('queries.status.colStatus')}</th>
          <th scope="col">{t.text('queries.status.colMeaning')}</th>
          <th scope="col">{t.text('queries.status.colWhen')}</th>
        </tr>
      </thead>
      <tbody>
        {
          statuses.map(([status, meaning, when]) => (
            <tr>
              <th scope="row" lang="en">
                {status}
              </th>
              <td set:html={t.html(meaning)} />
              <td set:html={t.html(when)} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

{
  handles && (
    <section id="answering" aria-labelledby="answering-h">
      <h2 id="answering-h">{t.text('queries.toc.answering')}</h2>
      <ol class="steps">
        {li(['queries.answer.1', 'queries.answer.2', 'queries.answer.3', 'queries.answer.4', 'queries.answer.5']).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ol>
      <p class="callout" set:html={t.html('queries.answer.callout')} />
    </section>
  )
}

{
  handles && (
    <section id="assigning" aria-labelledby="assigning-h">
      <h2 id="assigning-h">{t.text('queries.toc.assigning')}</h2>
      <p set:html={t.html('queries.assign.intro')} />
      <ul class="plain">
        {li(['queries.assign.1', 'queries.assign.2', 'queries.assign.3', 'queries.assign.4', 'queries.assign.5']).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ul>
    </section>
  )
}

{
  handles && (
    <section id="offices" aria-labelledby="offices-h">
      <h2 id="offices-h">{t.text('queries.toc.offices')}</h2>
      <ol class="steps">
        {li(['queries.pass.1', 'queries.pass.2', 'queries.pass.3']).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ol>
      <ul class="plain">
        {li(['queries.pass.nobody', 'queries.pass.clock', 'queries.pass.history']).map((k) => (
          <li set:html={t.html(k)} />
        ))}
        {office && <li set:html={t.html('queries.pass.leaves', { office })} />}
      </ul>
    </section>
  )
}

{
  handles && (
    <section id="notes" aria-labelledby="notes-h">
      <h2 id="notes-h">{t.text('queries.toc.notes')}</h2>
      <ul class="plain">
        {li(['queries.notes.1', 'queries.notes.2', 'queries.notes.3']).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ul>
    </section>
  )
}

<section id="finding" aria-labelledby="finding-h">
  <h2 id="finding-h">{t.text('queries.toc.finding')}</h2>
  <ul class="plain">
    <li set:html={t.html('queries.find.1')} />
    <li set:html={t.html(office ? 'queries.find.2office' : 'queries.find.2')} />
    <li set:html={t.html('queries.find.3')} />
  </ul>
</section>

{
  handles && (
    <section id="spam" aria-labelledby="spam-h">
      <h2 id="spam-h">{t.text('queries.toc.spam')}</h2>
      <p set:html={t.html(canDelete ? 'queries.spam.master' : 'queries.spam.other')} />
    </section>
  )
}

{
  handles && (
    <section id="good-practice" aria-labelledby="good-h">
      <h2 id="good-h">{t.text('queries.toc.good')}</h2>
      <ul class="plain">
        {li(['queries.good.1', 'queries.good.2', 'queries.good.3', 'queries.good.4', 'queries.good.5']).map((k) => (
          <li set:html={t.html(k)} />
        ))}
      </ul>
    </section>
  )
}

<section id="tracking" aria-labelledby="tracking-h">
  <h2 id="tracking-h">{t.text('queries.toc.tracking')}</h2>
  <p set:html={t.html('queries.track.intro')} />
  <div class="table-wrap">
    <table class="wide-cells">
      <thead>
        <tr>
          <th scope="col">{t.text('queries.track.colPanel')}</th>
          <th scope="col">{t.text('queries.track.colCustomer')}</th>
        </tr>
      </thead>
      <tbody>
        {
          tracking.map(([status, sees]) => (
            <tr>
              <th scope="row" lang="en">
                {status}
              </th>
              <td set:html={t.html(sees)} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p set:html={t.html('queries.track.outro')} />
</section>
