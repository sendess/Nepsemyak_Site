---
import Toc from '../Toc.astro';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const t = Astro.locals.helpText!;
---

<Toc
  items={[
    { id: 'activity', k: 'records.toc.activity' },
    { id: 'reading', k: 'records.toc.reading' },
    { id: 'files', k: 'records.toc.files' },
    { id: 'storage', k: 'records.toc.storage' },
  ]}
/>

<section id="activity" aria-labelledby="activity-h">
  <h2 id="activity-h">{t.text('records.toc.activity')}</h2>
  <p set:html={t.html('records.activity.intro')} />
  <ul class="plain">
    {(['records.activity.1', 'records.activity.2', 'records.activity.3'] as const).map((k) => <li set:html={t.html(k)} />)}
  </ul>
</section>

<section id="reading" aria-labelledby="reading-h">
  <h2 id="reading-h">{t.text('records.toc.reading')}</h2>
  <ul class="plain">
    {(['records.reading.1', 'records.reading.2', 'records.reading.3', 'records.reading.4'] as const).map((k) => <li set:html={t.html(k)} />)}
  </ul>
</section>

<section id="files" aria-labelledby="files-h">
  <h2 id="files-h">{t.text('records.toc.files')}</h2>
  <p set:html={t.html('records.files.text')} />
</section>

<section id="storage" aria-labelledby="storage-h">
  <h2 id="storage-h">{t.text('records.toc.storage')}</h2>
  <ul class="plain">
    {(['records.storage.1', 'records.storage.2', 'records.storage.3'] as const).map((k) => <li set:html={t.html(k)} />)}
  </ul>
</section>
