---
import Toc from '../Toc.astro';
import { ROLES, ROLE_LABEL, ROLE_SUMMARY, officeName, type AdminRole } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const { reader } = Astro.props;

type Cell = 'yes' | 'no' | string;
// One row per task; one value per role, in ROLES order (Master, Editor, Customer care, Viewer).
const rows: [task: string, cells: Record<AdminRole, Cell>][] = [
  ['Read customer queries', { owner: 'yes', editor: 'yes', support: 'Their office', viewer: 'yes' }],
  ['Answer queries: status, office, notes', { owner: 'yes', editor: 'yes', support: 'Their office', viewer: 'no' }],
  ['Email alerts for new queries', { owner: 'yes', editor: 'yes', support: 'Their office', viewer: 'If turned on' }],
  ['Delete a query', { owner: 'yes', editor: 'no', support: 'no', viewer: 'no' }],
  ['Notices, statistics, news, jobs, page content', { owner: 'yes', editor: 'yes', support: 'no', viewer: 'no' }],
  ['Website visitor numbers', { owner: 'yes', editor: 'yes', support: 'no', viewer: 'yes' }],
  ['Add or remove people, change roles', { owner: 'yes', editor: 'no', support: 'no', viewer: 'no' }],
  ['Activity log and stored files', { owner: 'yes', editor: 'no', support: 'no', viewer: 'no' }],
  ['My account and Help', { owner: 'yes', editor: 'yes', support: 'yes', viewer: 'yes' }],
];
const show = (c: Cell) => (c === 'yes' ? 'Yes' : c === 'no' ? '—' : c);
const mine = reader?.role;
---

<Toc
  items={[
    { id: 'your-role', label: 'Your role', show: Boolean(reader) },
    { id: 'four-roles', label: 'The four roles' },
    { id: 'compare', label: 'Side by side' },
    { id: 'offices', label: 'Customer care and offices' },
    { id: 'more-access', label: 'Needing more access' },
  ]}
/>

{
  reader && (
    <section id="your-role" aria-labelledby="your-role-h">
      <h2 id="your-role-h">Your role</h2>
      <p class="callout">
        You are <strong>{ROLE_LABEL[reader.role]}</strong>
        {reader.role === 'support' && <> for <strong>{officeName(reader.office) ?? 'all offices'}</strong></>}. {ROLE_SUMMARY[reader.role]}
      </p>
    </section>
  )
}

<section id="four-roles" aria-labelledby="four-h">
  <h2 id="four-h">The four roles</h2>
  <p>Each person gets the least access they need for their work. The master admin chooses a role when adding someone and can change it at any time.</p>
  <dl>
    <div>
      <dt>Master</dt>
      <dd>
        There is exactly one{reader?.masterName && <>, currently <strong>{reader.masterName}</strong></>}. Does everything, including managing
        people, reading the activity log and cleaning up stored files. Only the master can delete a query.
      </dd>
    </div>
    <div>
      <dt>Editor</dt>
      <dd>Keeps the website up to date (notices, news, jobs, statistics, About us and Our team) and answers queries from every office. Sees visitor numbers.</dd>
    </div>
    <div>
      <dt>Customer care</dt>
      <dd>Answers customer queries and nothing else. Can be tied to one office, then sees and is emailed about that office’s queries only. Can’t change anything on the website.</dd>
    </div>
    <div>
      <dt>Viewer</dt>
      <dd>For managers who want to follow along: reads the dashboard, visitor numbers and queries, but can’t change anything.</dd>
    </div>
  </dl>
</section>

<section id="compare" aria-labelledby="compare-h">
  <h2 id="compare-h">Side by side</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Task</th>
          {ROLES.map((r) => <th scope="col" class:list={['c', { mine: mine === r }]}>{ROLE_LABEL[r]}{mine === r && <span class="tag">You</span>}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map(([task, cells]) => (
            <tr>
              <th scope="row">{task}</th>
              {ROLES.map((r) => (
                <td class:list={['c', cells[r] === 'yes' ? 'yes' : cells[r] === 'no' ? 'no' : '', { mine: mine === r }]}>{show(cells[r])}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<section id="offices" aria-labelledby="offices-h">
  <h2 id="offices-h">Customer care and offices</h2>
  <p>
    Each query has an office: the one the customer picked on the contact form, or the one staff move it to. Customer care can be
    tied to one office, or look after all of them.
  </p>
  <ul class="plain">
    <li><strong>Tied to an office:</strong> sees that office’s queries plus any where the customer didn’t choose an office, so nothing is missed. Gets email alerts for the same queries only.</li>
    <li><strong>All offices:</strong> sees and is emailed about every query, like an Editor, but can’t change the website.</li>
    <li><strong>Moving a query</strong> to another office takes it out of your list. The staff of that office see it straight away.</li>
  </ul>
</section>

<section id="more-access" aria-labelledby="more-h">
  <h2 id="more-h">Needing more access</h2>
  <p>
    If you open a part of the panel your role doesn’t include, you’ll see a page saying so; nothing is broken. Ask the master
    admin: they can change your role under <span class="ui">Users</span>, and it applies from your next click. Every change of role
    is recorded in the activity log.
  </p>
</section>
