---
import Toc from '../Toc.astro';
import { ROLES, ROLE_LABEL, type AdminRole } from '~/lib/roles';
import { readerOffice, type HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const office = readerOffice(reader, t.lang);

type Cell = 'yes' | 'no' | HelpKey;
// One row per task; one value per role, in ROLES order (Master, Editor, Customer care, Viewer).
const rows: [task: HelpKey, cells: Record<AdminRole, Cell>][] = [
  ['roles.row.read', { owner: 'yes', editor: 'yes', support: 'roles.cell.office', viewer: 'yes' }],
  ['roles.row.answer', { owner: 'yes', editor: 'yes', support: 'roles.cell.office', viewer: 'no' }],
  ['roles.row.alerts', { owner: 'yes', editor: 'yes', support: 'roles.cell.office', viewer: 'roles.cell.ifOn' }],
  ['roles.row.delete', { owner: 'yes', editor: 'no', support: 'no', viewer: 'no' }],
  ['roles.row.content', { owner: 'yes', editor: 'yes', support: 'no', viewer: 'no' }],
  ['roles.row.visitors', { owner: 'yes', editor: 'yes', support: 'no', viewer: 'yes' }],
  ['roles.row.people', { owner: 'yes', editor: 'no', support: 'no', viewer: 'no' }],
  ['roles.row.records', { owner: 'yes', editor: 'no', support: 'no', viewer: 'no' }],
  ['roles.row.account', { owner: 'yes', editor: 'yes', support: 'yes', viewer: 'yes' }],
];
const show = (c: Cell) => (c === 'yes' ? t.text('roles.cell.yes') : c === 'no' ? '—' : t.text(c));
const mine = reader?.role;
const four: [AdminRole, HelpKey][] = [
  ['owner', reader?.masterName ? 'roles.four.masterNamed' : 'roles.four.master'],
  ['editor', 'roles.four.editor'],
  ['support', 'roles.four.support'],
  ['viewer', 'roles.four.viewer'],
];
---

<Toc
  items={[
    { id: 'your-role', k: 'roles.toc.yours', show: Boolean(reader) },
    { id: 'four-roles', k: 'roles.toc.four' },
    { id: 'compare', k: 'roles.toc.compare' },
    { id: 'offices', k: 'roles.toc.offices' },
    { id: 'more-access', k: 'roles.toc.more' },
  ]}
/>

{
  reader && (
    <section id="your-role" aria-labelledby="your-role-h">
      <h2 id="your-role-h">{t.text('roles.toc.yours')}</h2>
      <p
        class="callout"
        set:html={
          office
            ? t.html('roles.yours.office', { office, summary: t.text(`role.${reader.role}` as HelpKey) })
            : t.html('roles.yours.text', { role: ROLE_LABEL[reader.role], summary: t.text(`role.${reader.role}` as HelpKey) })
        }
      />
    </section>
  )
}

<section id="four-roles" aria-labelledby="four-h">
  <h2 id="four-h">{t.text('roles.toc.four')}</h2>
  <p set:html={t.html('roles.four.intro')} />
  <dl>
    {
      four.map(([role, k]) => (
        <div>
          <dt lang="en">{ROLE_LABEL[role]}</dt>
          <dd set:html={t.html(k, { name: reader?.masterName })} />
        </div>
      ))
    }
  </dl>
</section>

<section id="compare" aria-labelledby="compare-h">
  <h2 id="compare-h">{t.text('roles.toc.compare')}</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t.text('roles.compare.task')}</th>
          {
            ROLES.map((r) => (
              <th scope="col" class:list={['c', { mine: mine === r }]}>
                <span lang="en">{ROLE_LABEL[r]}</span>
                {mine === r && <span class="tag">{t.text('roles.compare.you')}</span>}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map(([task, cells]) => (
            <tr>
              <th scope="row">{t.text(task)}</th>
              {ROLES.map((r) => (
                <td class:list={['c', cells[r] === 'yes' ? 'yes' : cells[r] === 'no' ? 'no' : '', { mine: mine === r }]}>{show(cells[r])}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<section id="offices" aria-labelledby="offices-h">
  <h2 id="offices-h">{t.text('roles.toc.offices')}</h2>
  <p set:html={t.html('roles.offices.intro')} />
  <ul class="plain">
    <li set:html={t.html('roles.offices.tied')} />
    <li set:html={t.html('roles.offices.all')} />
    <li set:html={t.html('roles.offices.moving')} />
  </ul>
</section>

<section id="more-access" aria-labelledby="more-h">
  <h2 id="more-h">{t.text('roles.toc.more')}</h2>
  <p set:html={t.html('roles.more.text')} />
</section>
