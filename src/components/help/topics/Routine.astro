---
import { can, officeName } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const handles = can(reader, 'requests.handle');
const content = can(reader, 'content');
const isMaster = can(reader, 'people');
const officeLabel = reader?.role === 'support' ? officeName(reader.office) : null;

// Each block lists only the jobs this person's role includes.
const blocks: { title: string; items: string[] }[] = [
  {
    title: 'When an alert email arrives',
    items: handles
      ? [
          'Press “Open in the admin panel” in the email.',
          'Call or reply, then set the status to In progress with a note of what you did.',
          'Set Resolved when it’s done. Junk goes to Spam.',
        ]
      : [],
  },
  {
    title: 'Every working day',
    items: [
      ...(handles
        ? [
            `Open the dashboard and clear “Needs attention”${officeLabel ? ` for ${officeLabel}` : ''}.`,
            'By the end of the day, no query should still be New. Anything waiting more than a day shows in red.',
          ]
        : []),
      ...(content ? ['Check that the live banner or pop-up is still correct.'] : []),
      ...(!handles && !content ? ['Nothing daily: your role is for following along.'] : []),
    ],
  },
  {
    title: 'Every week',
    items: [
      ...(handles ? ['Look through queries In progress for more than a week, and chase or close them.'] : []),
      ...(content ? ['Close or extend jobs past their deadline.', 'Take down notices that are out of date.'] : []),
      ...(!handles ? ['Look over the dashboard: queries per week, what people write about, and how the website is doing.'] : []),
      ...(isMaster ? ['Skim Activity for changes or sign-ins you don’t recognise.'] : []),
    ],
  },
  {
    title: 'Every month',
    items: [
      ...(content ? ['Post at least one news story. The dashboard reminds you after 30 quiet days.'] : []),
      ...(handles ? ['Look at “What people write about”: a topic that keeps growing may need a notice or a change in the field.'] : []),
      ...(isMaster ? ['Clean up unused images under Files.', 'Check the Users list: remove anyone who has left and review roles.'] : []),
    ],
  },
  {
    title: 'Every six months',
    items: [
      ...(content ? ['Update Statistics and their “as of” dates. The dashboard flags any group older than six months.'] : []),
      'Make sure you still have recovery codes left (My account).',
      ...(isMaster ? ['Read through this Help centre and tell the developer about anything out of date.'] : []),
    ],
  },
].filter((b) => b.items.length > 0);
---

<p>A simple rhythm that keeps customers answered and the website current. Only the jobs your role includes are listed.</p>

<div class="cards">
  {
    blocks.map((b) => (
      <div class="card-box">
        <h3>{b.title}</h3>
        <ul>
          {b.items.map((i) => (
            <li>{i}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
