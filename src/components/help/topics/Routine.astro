---
import { can } from '~/lib/roles';
import { readerOffice, type HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const handles = can(reader, 'requests.handle');
const content = can(reader, 'content');
const isMaster = can(reader, 'people');
const office = readerOffice(reader, t.lang);
const when = <T,>(yes: boolean, items: T[]) => (yes ? items : []);

// Each block lists only the jobs this person's role includes.
const all: { title: HelpKey; items: HelpKey[] }[] = [
  { title: 'routine.alert.title', items: when(handles, ['routine.alert.1', 'routine.alert.2', 'routine.alert.3'] as HelpKey[]) },
  {
    title: 'routine.day.title',
    items: [
      ...when(handles, [office ? 'routine.day.dashboardOffice' : 'routine.day.dashboard', 'routine.day.new', 'routine.day.mine', 'routine.day.passed'] as HelpKey[]),
      ...when(content, ['routine.day.banner'] as HelpKey[]),
      ...when(!handles && !content, ['routine.day.follow'] as HelpKey[]),
    ],
  },
  {
    title: 'routine.week.title',
    items: [
      ...when(handles, ['routine.week.progress'] as HelpKey[]),
      ...when(content, ['routine.week.jobs', 'routine.week.notices'] as HelpKey[]),
      ...when(!handles, ['routine.week.dashboard'] as HelpKey[]),
      ...when(isMaster, ['routine.week.activity'] as HelpKey[]),
    ],
  },
  {
    title: 'routine.month.title',
    items: [
      ...when(content, ['routine.month.news'] as HelpKey[]),
      ...when(handles, ['routine.month.topics'] as HelpKey[]),
      ...when(isMaster, ['routine.month.files', 'routine.month.users'] as HelpKey[]),
    ],
  },
  {
    title: 'routine.six.title',
    items: [...when(content, ['routine.six.stats'] as HelpKey[]), 'routine.six.codes', ...when(isMaster, ['routine.six.help'] as HelpKey[])],
  },
];
const blocks = all.filter((b) => b.items.length > 0);
---

<p set:html={t.html('routine.intro')} />

<div class="cards">
  {
    blocks.map((b) => (
      <div class="card-box">
        <h3>{t.text(b.title)}</h3>
        <ul>
          {b.items.map((k) => (
            <li set:html={t.html(k, { office })} />
          ))}
        </ul>
      </div>
    ))
  }
</div>
