---
import Toc from '../Toc.astro';
import Check from '../Check.astro';
import { can } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const isMaster = can(reader, 'people');
---

<Toc
  items={[
    { id: 'rules', k: 'safety.toc.rules' },
    { id: 'password', k: 'safety.toc.password' },
    { id: 'authenticator', k: 'safety.toc.authenticator' },
    { id: 'recovery', k: 'safety.toc.recovery' },
    { id: 'customer-details', k: 'safety.toc.customers' },
    { id: 'suspicious', k: 'safety.toc.suspicious' },
  ]}
/>

<section id="rules" aria-labelledby="rules-h">
  <h2 id="rules-h">{t.text('safety.toc.rules')}</h2>
  <ul class="checklist">
    <Check remember="safe-own" title="safety.rule.own" detail="safety.rule.ownDetail" />
    <Check remember="safe-ask" title="safety.rule.ask" detail="safety.rule.askDetail" />
    <Check remember="safe-shared" title="safety.rule.shared" detail="safety.rule.sharedDetail" />
    <Check remember="safe-codes" title="safety.rule.codes" detail="safety.rule.codesDetail" />
    <Check remember="safe-suspect" title="safety.rule.suspect" detail="safety.rule.suspectDetail" />
  </ul>
</section>

<section id="password" aria-labelledby="password-h">
  <h2 id="password-h">{t.text('safety.toc.password')}</h2>
  <ul class="plain">
    <li set:html={t.html('safety.password.1')} />
    <li set:html={t.html('safety.password.2')} />
    <li set:html={t.html('safety.password.3')} />
  </ul>
</section>

<section id="authenticator" aria-labelledby="authenticator-h">
  <h2 id="authenticator-h">{t.text('safety.toc.authenticator')}</h2>
  <ul class="plain">
    <li set:html={t.html('safety.auth.1')} />
    <li set:html={t.html('safety.auth.2')} />
    <li set:html={t.html(isMaster ? 'safety.auth.newPhoneMaster' : 'safety.auth.newPhone')} />
  </ul>
</section>

<section id="recovery" aria-labelledby="recovery-h">
  <h2 id="recovery-h">{t.text('safety.toc.recovery')}</h2>
  <p set:html={t.html('safety.recovery.text')} />
</section>

<section id="customer-details" aria-labelledby="customer-h">
  <h2 id="customer-h">{t.text('safety.toc.customers')}</h2>
  <p set:html={t.html('safety.customers.text')} />
</section>

<section id="suspicious" aria-labelledby="suspicious-h">
  <h2 id="suspicious-h">{t.text('safety.toc.suspicious')}</h2>
  <p set:html={t.html('safety.suspicious.text')} />
  {isMaster && <p set:html={t.html('safety.suspicious.master')} />}
</section>
