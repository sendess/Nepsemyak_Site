---
import { can } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';
import type { HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const t = Astro.locals.helpText!;
const handles = can(reader, 'requests.handle');
const content = can(reader, 'content');
const isMaster = can(reader, 'people');
const support = reader?.role === 'support';

// Rows shown to everyone before sign-in; once signed in, only rows that fit the reader's role.
const rows: { problem: HelpKey; fix: HelpKey; show: boolean }[] = [
  { problem: 'trouble.code.problem', fix: 'trouble.code.fix', show: true },
  { problem: 'trouble.app.problem', fix: 'trouble.app.fix', show: true },
  { problem: 'trouble.tooMany.problem', fix: 'trouble.tooMany.fix', show: true },
  { problem: 'trouble.phone.problem', fix: isMaster ? 'trouble.phone.fixMaster' : 'trouble.phone.fix', show: true },
  { problem: 'trouble.lostAll.problem', fix: isMaster ? 'trouble.lostAll.fixMaster' : 'trouble.lostAll.fix', show: true },
  { problem: 'trouble.menu.problem', fix: 'trouble.menu.fix', show: !reader || !isMaster },
  { problem: 'trouble.alerts.problem', fix: 'trouble.alerts.fix', show: !reader || handles },
  { problem: 'trouble.gone.problem', fix: 'trouble.gone.fix', show: !reader || support },
  { problem: 'trouble.track.problem', fix: 'trouble.track.fix', show: !reader || handles },
  { problem: 'trouble.passed.problem', fix: 'trouble.passed.fix', show: !reader || handles },
  { problem: 'trouble.notShowing.problem', fix: 'trouble.notShowing.fix', show: !reader || content },
  { problem: 'trouble.mistake.problem', fix: isMaster ? 'trouble.mistake.fixMaster' : 'trouble.mistake.fix', show: !reader || content },
  { problem: 'trouble.alertsAll.problem', fix: 'trouble.alertsAll.fix', show: isMaster },
  { problem: 'trouble.visitors.problem', fix: 'trouble.visitors.fix', show: isMaster },
  { problem: 'trouble.helpText.problem', fix: 'trouble.helpText.fix', show: isMaster },
];
const shown = rows.filter((r) => r.show);
---

<div class="table-wrap">
  <table class="wide-cells">
    <thead>
      <tr>
        <th scope="col">{t.text('trouble.colProblem')}</th>
        <th scope="col">{t.text('trouble.colFix')}</th>
      </tr>
    </thead>
    <tbody>
      {
        shown.map((r) => (
          <tr>
            <th scope="row">{t.text(r.problem)}</th>
            <td set:html={t.html(r.fix)} />
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p set:html={t.html(isMaster ? 'trouble.stuckMaster' : 'trouble.stuck')} />
