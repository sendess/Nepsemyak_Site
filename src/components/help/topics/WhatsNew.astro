---
import type { HelpReader } from '~/lib/help';
import { HELP_KEYS, type HelpKey } from '~/lib/help-text';

type Props = { reader: HelpReader };
const t = Astro.locals.helpText!;

// Newest first. To add an entry, add "whatsnew.<id>.date" and "whatsnew.<id>.1", ".2"… to both
// src/data/help/en.ts and ne.ts, and put <id> at the front of this list.
const ENTRIES = ['2026-09-22b', '2026-09-22', '2026-09-21', '2026-09-18', '2026-09-17'];
const entries = ENTRIES.map((id) => ({
  id,
  date: `whatsnew.${id}.date` as HelpKey,
  items: HELP_KEYS.filter((k) => k.startsWith(`whatsnew.${id}.`) && !k.endsWith('.date')),
}));
---

<div class="changes">
  {
    entries.map((e) => (
      <section aria-labelledby={`new-${e.id}`}>
        <h2 id={`new-${e.id}`}>{t.text(e.date)}</h2>
        <ul class="plain">
          {e.items.map((k) => (
            <li set:html={t.html(k)} />
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .changes {
    display: grid;
    gap: 1.5rem;
  }
</style>
