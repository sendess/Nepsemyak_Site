---
// Nepali version of ../GettingStarted.astro. Keep the two in step. Button and menu names stay in English, as in the panel.
import Toc from '../../Toc.astro';
import { can, type Permission } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const { reader } = Astro.props;

const menu: { label: string; what: string; need?: Permission }[] = [
  { label: 'Dashboard', what: 'तपाईंको सुरुको पृष्ठ: ध्यान दिनुपर्ने कुरा र पछिल्ला तथ्याङ्क।' },
  { label: 'Requests', what: 'वेबसाइटको सम्पर्क फारामबाट आएका ग्राहकका सोधपुछ।', need: 'requests.view' },
  { label: 'Notices', what: 'वेबसाइटमा ब्यानर वा पप-अपका रूपमा देखिने सूचना।', need: 'content' },
  { label: 'Statistics', what: 'Home, Impact र Careers पृष्ठका तथ्य र तथ्याङ्क।', need: 'content' },
  { label: 'News', what: 'News पृष्ठ र गृहपृष्ठका समाचार।', need: 'content' },
  { label: 'Jobs', what: 'Careers पृष्ठका रिक्त पदहरू।', need: 'content' },
  { label: 'Pages', what: 'About us र Our team का पाठ र फोटो।', need: 'content' },
  { label: 'Users', what: 'कसलाई पहुँच छ, र कसले के गर्न सक्छ।', need: 'people' },
  { label: 'Activity', what: 'हरेक परिवर्तन र साइन इनको अभिलेख, जसलाई कसैले बदल्न सक्दैन।', need: 'activity' },
  { label: 'Files', what: 'अपलोड गरिएका फोटो र डाटाबेसको भण्डारण।', need: 'files' },
  { label: 'My account', what: 'तपाईंको पासवर्ड, इमेल सूचना र रिकभरी कोड।' },
  { label: 'Help', what: 'तपाईंको भूमिकाअनुसार लेखिएका यी निर्देशिका।' },
];
const myMenu = reader ? menu.filter((m) => !m.need || can(reader, m.need)) : [];
---

<Toc
  lang="ne"
  items={[
    { id: 'before', label: 'सुरु गर्नुअघि' },
    { id: 'first-sign-in', label: 'पहिलो पटक साइन इन' },
    { id: 'signing-in', label: 'त्यसपछि साइन इन गर्दा' },
    { id: 'find-your-way', label: 'प्यानलमा के कहाँ छ', show: Boolean(reader) },
  ]}
/>

<section id="before" aria-labelledby="before-h">
  <h2 id="before-h">सुरु गर्नुअघि</h2>
  <p>पहिलो पटक साइन इन गर्नुअघि यी कुरामा चिनो लगाउनुहोस्। तपाईंका चिनो यही उपकरणमा मात्र सुरक्षित रहन्छन्।</p>
  <ul class="checklist">
    <li>
      <label>
        <input type="checkbox" data-remember="pre-email" />
        <span>
          <strong>तपाईंले खोल्न सक्ने कामको इमेल ठेगाना।</strong>
          <small>मास्टर एडमिनले यही ठेगाना थप्नुहुन्छ। पासवर्ड राख्ने कोड यहीँ आउँछ, र तपाईंको भूमिकामा सोधपुछको जवाफ दिने काम भए नयाँ सोधपुछको इमेल सूचना पनि यहीँ आउँछ।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="pre-phone" />
        <span>
          <strong>Google Authenticator राखिएको आफ्नै स्मार्टफोन।</strong>
          <small>Play Store वा App Store बाट निःशुल्क पाइन्छ; Microsoft Authenticator पनि चल्छ। पासवर्डपछि टाइप गर्ने ६ अङ्कको कोड यसैले दिन्छ।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="pre-clock" />
        <span>
          <strong>फोनको घडी स्वचालित (automatic) समयमा राखिएको।</strong>
          <small>कोड समयमा आधारित हुन्छ। घडी केही मिनेट फरक भए वेबसाइटले कोड मान्दैन।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="pre-paper" />
        <span>
          <strong>१० वटा रिकभरी कोड सुरक्षित राख्ने ठाउँ।</strong>
          <small>ताल्चा लाग्ने दराजमा कागजमा, वा पासवर्ड म्यानेजरमा। फोन हराए यिनैले भित्र पस्न दिन्छन्।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="pre-browser" />
        <span>
          <strong>अद्यावधिक ब्राउजर।</strong>
          <small>कम्प्युटर वा फोनमा Chrome, Edge, Firefox वा Safari। समाचार लेख्न र पृष्ठ सम्पादन गर्न कम्प्युटर सजिलो हुन्छ।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="pre-role" />
        <span>
          <strong>आफ्नो भूमिका, र सोधपुछको जवाफ दिने भए आफ्नो कार्यालय थाहा पाउनुहोस्।</strong>
          <small>तपाईंलाई थप्दा मास्टर एडमिनले यो छान्नुहुन्छ। <a href="/admin/help/roles">कुन भूमिकाले के गर्न सक्छ हेर्नुहोस्।</a></small>
        </span>
      </label>
    </li>
  </ul>
</section>

<section id="first-sign-in" aria-labelledby="first-h">
  <h2 id="first-h">पहिलो पटक साइन इन</h2>
  <p>यसमा करिब दस मिनेट लाग्छ। फोन छेउमै राखेर एकैपटक गर्नुहोस्।</p>

  <p class="track">मास्टर एडमिनले गर्ने</p>
  <ol class="steps">
    <li><span class="ui">Users</span> खोलेर तपाईंको इमेल र नाम लेख्नुहुन्छ, भूमिका (Customer care भए कार्यालय पनि) छान्नुहुन्छ, र <span class="ui">Add</span> थिच्नुहुन्छ।</li>
    <li>तपाईंलाई यो पृष्ठको लिङ्क पठाउनुहुन्छ: <span class="path">nepsemyak.com.np/admin/help/getting-started</span></li>
  </ol>

  <p class="track">तपाईंले गर्ने</p>
  <ol class="steps">
    <li><a href="/admin/reset-password">Set or reset your password</a> मा जानुहोस् (साइन इन पृष्ठमा यो <span class="ui">Forgot password?</span> हो)। नयाँ कर्मचारीले पहिलो पासवर्ड पनि यहीँबाट राख्छन्।</li>
    <li>आफ्नो कामको इमेल लेख्नुहोस्। केही मिनेटमै ६ अङ्कको कोड इमेलमा आउँछ। नआए Spam वा Promotions फोल्डर हेर्नुहोस्।</li>
    <li>कोड टाइप गरेर <strong>कम्तीमा १० अक्षरको</strong> पासवर्ड राख्नुहोस्। अरू कतै प्रयोग नगरेको पासवर्ड राख्नुहोस्; आपसमा सम्बन्ध नभएका केही शब्द सम्झन सजिलो र अनुमान गर्न गाह्रो हुन्छन्।</li>
    <li><span class="path">nepsemyak.com.np/admin/login</span> मा आफ्नो इमेल र नयाँ पासवर्डले साइन इन गर्नुहोस्।</li>
    <li>प्यानलले दुई-चरणको साइन इन (two-step sign-in) मिलाउन भन्छ। Google Authenticator मा <span class="ui">+</span> थिचेर <span class="ui">Scan a QR code</span> छान्नुहोस्, र स्क्रिनमा देखिएको कोड स्क्यान गर्नुहोस्। एपमा <strong>Nepsemyak Admin</strong> देखिन्छ, जसमा हरेक ३० सेकेन्डमा बदलिने ६ अङ्कको कोड हुन्छ।</li>
    <li>एपमा देखिएको कोड टाइप गरेर <span class="ui">Turn on</span> थिच्नुहोस्।</li>
    <li>प्यानलले देखाउने <strong>१० वटा रिकभरी कोड</strong> सुरक्षित राख्नुहोस्। हरेक कोड एक पटक, एपको कोडको सट्टा चल्छ। यी एक पटक मात्र देखाइन्छन्।</li>
    <li>तपाईं <span class="ui">Dashboard</span> मा पुग्नुहुन्छ। तपाईंको भूमिकामा सोधपुछको जवाफ दिने काम भए <span class="ui">My account</span> खोलेर <span class="ui">Email me about new queries</span> मा चिनो छ कि हेर्नुहोस्, र <span class="ui">Send me a test email</span> थिच्नुहोस्। इमेल Spam मा गए “Not spam” भनिदिनुहोस्, ताकि वास्तविक सूचना Inbox मा आओस्।</li>
    <li>सबै भयो भनी मास्टर एडमिनलाई जानकारी दिनुहोस्। उहाँले <span class="ui">Users</span> मा तपाईंले पछिल्लो पटक कहिले साइन इन गर्नुभयो देख्न सक्नुहुन्छ।</li>
  </ol>
</section>

<section id="signing-in" aria-labelledby="signing-h">
  <h2 id="signing-h">त्यसपछि साइन इन गर्दा</h2>
  <p>
    वेबसाइटको कुनै पनि पृष्ठको सबैभन्दा तल रहेको <span class="ui">Staff login</span> (नेपाली पृष्ठमा “कर्मचारी लगइन”) प्रयोग
    गर्नुहोस्, वा सिधै <span class="path">nepsemyak.com.np/admin/login</span> मा जानुहोस्। इमेल र पासवर्डपछि एपको ६ अङ्कको
    कोड हाल्नुहोस्। प्यानलले हरेक १२ घण्टामा नयाँ कोड माग्छ।
  </p>
  <p class="callout warn">
    <strong>एउटै उपकरणबाट पाँच पटक गलत पासवर्ड वा कोड हालेमा १५ मिनेटका लागि साइन इन रोकिन्छ।</strong> फेरि अनुमान
    गर्नुको सट्टा पर्खनुहोस्। हरेक प्रयास अभिलेखमा रहन्छ।
  </p>
</section>

{
  reader && (
    <section id="find-your-way" aria-labelledby="find-h">
      <h2 id="find-h">प्यानलमा के कहाँ छ</h2>
      <p>
        बायाँको मेनुमा तपाईंको भूमिकामा पर्ने भाग मात्र देखिन्छन्। हरेक पृष्ठको माथि <span class="ui">Help</span> बटन पनि छ, जसले
        त्यो पृष्ठको निर्देशिका खोल्छ।
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">मेनुमा</th>
              <th scope="col">केका लागि</th>
            </tr>
          </thead>
          <tbody>
            {myMenu.map((m) => (
              <tr>
                <th scope="row" lang="en">{m.label}</th>
                <td>{m.what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
