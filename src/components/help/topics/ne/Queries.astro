---
// Nepali version of ../Queries.astro. Keep the two in step. Button and menu names stay in English, as in the panel.
import Toc from '../../Toc.astro';
import { branches } from '~/data/site';
import { can } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const handles = can(reader, 'requests.handle');
const canDelete = can(reader, 'requests.delete');
const office = reader?.role === 'support' ? reader.office : null;
const officeLabel = branches.find((b) => b.id === office)?.name.ne ?? null;
---

<Toc
  lang="ne"
  items={[
    { id: 'where', label: 'सोधपुछ कहाँबाट आउँछ' },
    { id: 'your-list', label: 'तपाईंको सूची', show: Boolean(officeLabel) },
    { id: 'read-only', label: 'पढ्ने मात्र', show: !handles },
    { id: 'statuses', label: 'हरेक अवस्थाको अर्थ' },
    { id: 'answering', label: 'जवाफ दिने तरिका', show: handles },
    { id: 'assigning', label: 'कसले हेर्दैछ', show: handles },
    { id: 'offices', label: 'अर्को कार्यालयमा पठाउने', show: handles },
    { id: 'notes', label: 'नोट लेख्ने', show: handles },
    { id: 'finding', label: 'सोधपुछ खोज्ने' },
    { id: 'spam', label: 'स्प्याम र मेटाउने', show: handles },
    { id: 'good-practice', label: 'राम्रो अभ्यास', show: handles },
    { id: 'tracking', label: 'ग्राहकले के देख्छन्' },
  ]}
/>

<section id="where" aria-labelledby="where-h">
  <h2 id="where-h">सोधपुछ कहाँबाट आउँछ</h2>
  <ul class="plain">
    <li>ग्राहकले वेबसाइटको <strong>Contact</strong> पृष्ठको फाराम अङ्ग्रेजी वा नेपालीमा भर्छन्। उनीहरू विषय छान्छन्, र थाहा भए कार्यालय पनि छान्छन्।</li>
    <li>हरेक सोधपुछ तुरुन्तै सुरक्षित हुन्छ र ग्राहकले <code>NS-7K4P2Q</code> जस्तो <strong>सन्दर्भ नम्बर</strong> पाउँछन्। उनीहरूले फोन गरे त्यो नम्बर सोधेर खोज्नुहोस्।</li>
    <li>
      <span class="ui">My account</span> मा सूचना खुला राख्ने, सोधपुछको जवाफ दिने सबैलाई <strong>इमेल सूचना</strong> जान्छ{
        officeLabel ? `; तपाईंका लागि ${officeLabel} र कार्यालय नछानिएका सोधपुछको` : ''
      }।
    </li>
    <li>लुकेको जाँचले धेरैजसो रोबोट रोक्छ, र एउटै उपकरणबाट घण्टामा पाँचवटा मात्र सन्देश पठाउन सकिन्छ।</li>
  </ul>
</section>

{
  officeLabel && (
    <section id="your-list" aria-labelledby="your-list-h">
      <h2 id="your-list-h">तपाईंको सूची</h2>
      <p class="callout">
        तपाईं <strong>{officeLabel}</strong> हेर्नुहुन्छ। <span class="ui">Requests</span> मा त्यस कार्यालयका सोधपुछ र ग्राहकले
        कार्यालय नछानेका सोधपुछ देखिन्छन्, ताकि कुनै नछुटोस्। अरू कार्यालयका सोधपुछ देखिँदैनन्, र तिनका लिङ्क पनि तपाईंका लागि
        खुल्दैनन्।
      </p>
    </section>
  )
}

{
  !handles && (
    <section id="read-only" aria-labelledby="read-only-h">
      <h2 id="read-only-h">पढ्ने मात्र</h2>
      <p>
        तपाईंको भूमिकाले हरेक सोधपुछ, त्यसका नोट र इतिहाससहित पढ्न दिन्छ, तर अवस्था वा कार्यालय बदल्न वा नोट थप्न दिँदैन।
        कुनै सोधपुछमा काम गराउनुपरे सन्दर्भ नम्बर भन्दै सम्बन्धित कार्यालय वा मास्टर एडमिनलाई भन्नुहोस्।
      </p>
    </section>
  )
}

<section id="statuses" aria-labelledby="statuses-h">
  <h2 id="statuses-h">हरेक अवस्थाको अर्थ</h2>
  <div class="table-wrap">
    <table class="wide-cells">
      <thead>
        <tr><th scope="col">अवस्था</th><th scope="col">अर्थ</th><th scope="col">कहिले प्रयोग गर्ने</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row" lang="en">New</th><td>अहिलेसम्म कसैले हेरेको छैन।</td><td>हरेक सोधपुछ यहीँबाट सुरु हुन्छ। २४ घण्टापछि यसलाई ढिला भएको मानिन्छ र ड्यासबोर्डमा रातोमा देखिन्छ।</td></tr>
        <tr><th scope="row" lang="en">In progress</th><td>कसैले काम गर्दैछ।</td><td>फोन गर्ने, जवाफ दिने वा टोलीलाई पठाउनेबित्तिकै, ताकि अरूले उही काम दोहोर्‍याउनु नपरोस्।</td></tr>
        <tr><th scope="row" lang="en">Resolved</th><td>सकियो।</td><td>ग्राहकको समस्या समाधान भएपछि वा प्रश्नको जवाफ दिएपछि।</td></tr>
        <tr><th scope="row" lang="en">Spam</th><td>वास्तविक सोधपुछ होइन।</td><td>विज्ञापन, अर्थहीन सन्देश वा परीक्षण। Spam सबै तथ्याङ्क र चार्टबाट हटाइन्छ।</td></tr>
      </tbody>
    </table>
  </div>
</section>

{
  handles && (
    <section id="answering" aria-labelledby="answering-h">
      <h2 id="answering-h">जवाफ दिने तरिका</h2>
      <ol class="steps">
        <li>इमेल सूचनाबाट (<span class="ui">Open in the admin panel</span>) वा <span class="ui">Requests</span> बाट खोल्नुहोस्। नयाँ सोधपुछ गाढा अक्षरमा देखिन्छन्।</li>
        <li>सन्देश र दायाँपट्टिको ग्राहकको विवरण पढ्नुहोस्। फोनबाट हेर्दै हुनुहुन्छ भने फोन नम्बरमा थिचेर सिधै कल गर्न सकिन्छ।</li>
        <li>ग्राहकलाई फोन गर्नुहोस्, वा इमेलबाट जवाफ दिनुहोस्। इमेल सूचनामा Reply गर्दा, वा सोधपुछमा रहेको इमेल लिङ्क प्रयोग गर्दा सिधै ग्राहकलाई जान्छ।</li>
        <li><span class="ui">What happens next</span> मा अवस्था <span class="ui">In progress</span> बनाउनुहोस्, के गर्नुभयो वा के वाचा गर्नुभयो नोटमा लेख्नुहोस्, र <span class="ui">Save</span> थिच्नुहोस्।</li>
        <li>काम सकिएपछि छोटो नोटसहित <span class="ui">Resolved</span> बनाउनुहोस्।</li>
      </ol>
      <p class="callout">इमेलबाट दिएको जवाफ प्यानलमा आफैं अभिलेख हुँदैन। टोली र ड्यासबोर्डलाई अवस्था थाहा होस् भनेर सधैं अवस्था बदल्नुहोस् र नोट थप्नुहोस्।</p>
    </section>
  )
}

{
  handles && (
    <section id="assigning" aria-labelledby="assigning-h">
      <h2 id="assigning-h">कसले हेर्दैछ</h2>
      <p>हरेक सोधपुछ एक जनाको जिम्मामा दिन सकिन्छ, ताकि दुई जनाले एउटै ग्राहकलाई फोन नगरून्, र “अरूले हेरिरहेका होलान्” भनेर कुनै सोधपुछ नछुटोस्।</p>
      <ul class="plain">
        <li>आफैं लिन सोधपुछको माथिको <span class="ui">Assign to me</span> थिच्नुहोस्, वा <span class="ui">Assigned to</span> मा कसैलाई छानेर <span class="ui">Save</span> थिच्नुहोस्।</li>
        <li>कसैको जिम्मामा नभएको सोधपुछलाई <span class="ui">In progress</span> बनाउँदा त्यो आफैं तपाईंको जिम्मामा आउँछ।</li>
        <li>सहकर्मीले तपाईंलाई सोधपुछ जिम्मा दिँदा तपाईंलाई इमेल आउँछ (My account मा सूचना खुला भए)।</li>
        <li>सोधपुछको कार्यालय देख्न पाउनेलाई मात्र छान्न सकिन्छ। उहाँले नहेर्ने कार्यालयमा सोधपुछ सारेमा जिम्मा हट्छ।</li>
        <li><span class="ui">Requests</span> मा <span class="ui">My queries</span> वा <span class="ui">Not assigned yet</span> ले छान्नुहोस्। तपाईंका कति सोधपुछ अझै खुला छन् भनेर ड्यासबोर्डले देखाउँछ।</li>
      </ul>
    </section>
  )
}

{
  handles && (
    <section id="offices" aria-labelledby="offices-h">
      <h2 id="offices-h">अर्को कार्यालयमा पठाउने</h2>
      <ol class="steps">
        <li><span class="ui">Office dealing with it</span> मा यसलाई हेर्नुपर्ने कार्यालय छान्नुहोस्।</li>
        <li><span class="ui">Add a note</span> मा किन पठाउँदै हुनुहुन्छ र अहिलेसम्म के भयो लेख्नुहोस्। यो नोट त्यस कार्यालयलाई जाने इमेलमा पनि जान्छ।</li>
        <li><span class="ui">Save</span> थिच्नुहोस्। त्यस कार्यालयका Customer care ले तुरुन्तै इमेल पाउँछन्, र उनीहरूको सूचीमा सोधपुछमा “Passed from …” देखिन्छ।</li>
      </ol>
      <ul class="plain">
        <li>त्यस कार्यालयमा कसैले पनि इमेल सूचना नपाउने भए प्यानलले भन्छ: त्यसो भए उनीहरूलाई फोन गर्नुहोस्।</li>
        <li>पाउने कार्यालयका लागि, पठाइएको सोधपुछको पर्खाइ त्यहाँ पुगेको बेलादेखि गनिन्छ, ग्राहकले लेखेको बेलादेखि होइन।</li>
        <li>हरेक सराइ सोधपुछको <span class="ui">Passed between offices</span> मा देखिन्छ: कसले सार्‍यो, नोट, र इमेल गयो कि गएन।</li>
        {officeLabel && <li>{officeLabel} बाट सोधपुछ पठाउँदा त्यो तपाईंको सूचीबाट हट्छ, र तपाईं त्यसबारे सन्देशसहित <span class="ui">Requests</span> मा फर्किनुहुन्छ।</li>}
      </ul>
    </section>
  )
}

{
  handles && (
    <section id="notes" aria-labelledby="notes-h">
      <h2 id="notes-h">नोट लेख्ने</h2>
      <ul class="plain">
        <li>नोट प्यानलभित्र मात्र रहन्छ। ग्राहकले कहिल्यै देख्दैनन्।</li>
        <li>नोट बदल्न वा मेटाउन मिल्दैन, र कसले कहिले लेख्यो देखिन्छ। लगबुकमा लेखेजस्तै लेख्नुहोस्।</li>
        <li>राम्रो नोटमा के गरियो र के वाचा गरियो भन्ने हुन्छ: “२ बजे फोन गरेँ, आइतबार बिहान गाडी पठाउने भनियो, सोमबार फेरि फोन गर्ने।”</li>
      </ul>
    </section>
  )
}

<section id="finding" aria-labelledby="finding-h">
  <h2 id="finding-h">सोधपुछ खोज्ने</h2>
  <ul class="plain">
    <li>नाम, फोन नम्बर, सन्देशका शब्द वा सन्दर्भ नम्बरले खोज्नुहोस्।</li>
    <li>अवस्था वा विषय{officeLabel ? '' : ', वा कार्यालय'} अनुसार छान्नुहोस्। स्तम्भको शीर्षकमा थिचेर क्रम मिलाउनुहोस्; प्यानलले तपाईंको छनोट सम्झन्छ।</li>
    <li>ड्यासबोर्डका तथ्याङ्क र चार्टमा थिचेर मिल्ने सूचीमा पुग्न सकिन्छ।</li>
  </ul>
</section>

{
  handles && (
    <section id="spam" aria-labelledby="spam-h">
      <h2 id="spam-h">स्प्याम र मेटाउने</h2>
      <p>
        फोहोर सन्देशलाई मेटाउनुको सट्टा <span class="ui">Spam</span> बनाउनुहोस्।{' '}
        {canDelete
          ? 'मास्टरका रूपमा तपाईं “Delete this message” बाट सोधपुछ मेटाउन पनि सक्नुहुन्छ। मेटाइएको पाठ Activity अभिलेखमा रहन्छ, त्यसैले केही पनि सधैंका लागि हराउँदैन।'
          : 'सोधपुछ मास्टर एडमिनले मात्र मेटाउन सक्नुहुन्छ, र त्यसपछि पनि त्यसको पाठ Activity अभिलेखमा रहन्छ।'}
      </p>
    </section>
  )
}

{
  handles && (
    <section id="good-practice" aria-labelledby="good-h">
      <h2 id="good-h">राम्रो अभ्यास</h2>
      <ul class="plain">
        <li>हरेक सोधपुछको जवाफ सोही कार्यदिनमा दिनुहोस्। एक दिनभन्दा बढी पर्खिएका सोधपुछ ड्यासबोर्डमा रातोमा देखिन्छन्।</li>
        <li>जरुरी कुरामा (फोहोर नउठेको, फोहोर पोखिएको) लेख्नुभन्दा फोन गर्नुहोस्।</li>
        <li>कुरा गर्दा ग्राहकलाई सन्दर्भ नम्बर भन्नुहोस्, र अरू कार्यालयसँग कुरा गर्दा पनि त्यही नम्बर प्रयोग गर्नुहोस्।</li>
        <li>कार्यालयले गर्न सक्ने कुराको मात्र वाचा गर्नुहोस्, र वाचा नोटमा लेख्नुहोस्।</li>
        <li>कर्मचारीबारे गुनासो: विनम्र रहनुहोस्, तथ्य नोट गर्नुहोस्, र कार्यालय प्रमुखलाई जानकारी दिनुहोस्।</li>
      </ul>
    </section>
  )
}

<section id="tracking" aria-labelledby="tracking-h">
  <h2 id="tracking-h">ग्राहकले के देख्छन्</h2>
  <p>
    ग्राहकले वेबसाइटको <strong>“सन्देशको अवस्था हेर्नुहोस्”</strong> (Track a message) पृष्ठमा — Contact पृष्ठ र फुटरमा यसको
    लिङ्क छ — सन्दर्भ नम्बर र फोन नम्बरका अन्तिम ४ अङ्क हालेर आफ्नो सन्देश हेर्न सक्छन्। उनीहरूले यति मात्र देख्छन्:
  </p>
  <div class="table-wrap">
    <table class="wide-cells">
      <thead>
        <tr><th scope="col">प्यानलमा अवस्था</th><th scope="col">ग्राहकले देख्ने</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row" lang="en">New</th><td>“प्राप्त भयो”: कार्यालयबाट सम्पर्क गरिनेछ।</td></tr>
        <tr><th scope="row" lang="en">In progress</th><td>“काम भइरहेको छ”, कार्यालय र त्यसको फोन नम्बरसहित।</td></tr>
        <tr><th scope="row" lang="en">Resolved</th><td>“समाधान भयो”, र समस्या अझै भए फोन गर्न।</td></tr>
        <tr><th scope="row" lang="en">Spam</th><td>“बन्द गरियो”, र अझै सहयोग चाहिए कार्यालयमा फोन गर्न।</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    उनीहरूले प्राप्त मिति र पछिल्लो अद्यावधिकको मिति पनि देख्छन्। नोट, कर्मचारीको नाम वा कसको जिम्मामा छ भन्ने कहिल्यै
    देख्दैनन्। अवस्था अद्यावधिक राख्दा मात्र यो पृष्ठ सही रहन्छ।
  </p>
</section>
