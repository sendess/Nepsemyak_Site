---
// Nepali version of ../Safety.astro. Keep the two in step.
import Toc from '../../Toc.astro';
import { can } from '~/lib/roles';
import type { HelpReader } from '~/lib/help';

type Props = { reader: HelpReader };
const { reader } = Astro.props;
const isMaster = can(reader, 'people');
---

<Toc
  lang="ne"
  items={[
    { id: 'rules', label: 'पाँच नियम' },
    { id: 'password', label: 'तपाईंको पासवर्ड' },
    { id: 'authenticator', label: 'Authenticator एप' },
    { id: 'recovery', label: 'रिकभरी कोड' },
    { id: 'customer-details', label: 'ग्राहकको विवरण' },
    { id: 'suspicious', label: 'केही शङ्कास्पद देखिए' },
  ]}
/>

<section id="rules" aria-labelledby="rules-h">
  <h2 id="rules-h">पाँच नियम</h2>
  <ul class="checklist">
    <li>
      <label>
        <input type="checkbox" data-remember="safe-own" />
        <span>
          <strong>एक व्यक्ति, एक खाता।</strong>
          <small>आफ्नो पासवर्ड वा Authenticator कसैलाई नदिनुहोस्। हरेक परिवर्तन तपाईंकै नाममा Activity अभिलेखमा रहन्छ।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="safe-ask" />
        <span>
          <strong>नेप्सेम्याकका कसैले पनि तपाईंको कोड वा पासवर्ड माग्दैनन्।</strong>
          <small>फोन, इमेल, WhatsApp वा च्याट कतैबाट पनि होइन। कसैले मागे त्यो हामी होइनौं: नदिनुहोस् र मास्टर एडमिनलाई भन्नुहोस्।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="safe-shared" />
        <span>
          <strong>कार्यालयका साझा कम्प्युटरमा ब्राउजरलाई पासवर्ड सम्झन नदिनुहोस्, र काम सकेपछि साइन आउट गर्नुहोस्।</strong>
          <small><span class="ui">Sign out</span> हरेक एडमिन पृष्ठको माथि दायाँ छ।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="safe-codes" />
        <span>
          <strong>रिकभरी कोड कागजमा वा पासवर्ड म्यानेजरमा मात्र राख्नुहोस्।</strong>
          <small>इमेल, WhatsApp वा फोनको फोटोमा होइन।</small>
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-remember="safe-suspect" />
        <span>
          <strong>कसैलाई पासवर्ड थाहा भयो कि जस्तो लागे तुरुन्तै बदल्नुहोस्।</strong>
          <small>पासवर्ड बदल्दा अरू सबै उपकरणबाट साइन आउट हुन्छ। त्यसपछि मास्टर एडमिनलाई भन्नुहोस्।</small>
        </span>
      </label>
    </li>
  </ul>
</section>

<section id="password" aria-labelledby="password-h">
  <h2 id="password-h">तपाईंको पासवर्ड</h2>
  <ul class="plain">
    <li>कम्तीमा १० अक्षर। आपसमा सम्बन्ध नभएका केही शब्द (जस्तै “mango bicycle Tuesday river”) बलियो र सम्झन सजिलो हुन्छन्।</li>
    <li><span class="ui">My account</span> → <span class="ui">Password</span> मा बदल्न सकिन्छ। बदल्दा अरू सबै उपकरणबाट साइन आउट हुन्छ।</li>
    <li>बिर्सनुभयो? साइन इन पृष्ठमा <span class="ui">Forgot password?</span> छान्नुहोस्; इमेलमा कोड आउँछ। त्यसपछि पनि Authenticator चाहिन्छ, त्यसैले इमेल मात्र पाएर कसैले भित्र पस्न सक्दैन।</li>
  </ul>
</section>

<section id="authenticator" aria-labelledby="authenticator-h">
  <h2 id="authenticator-h">Authenticator एप</h2>
  <ul class="plain">
    <li>६ अङ्कको कोड हरेक ३० सेकेन्डमा बदलिन्छ। बदलिनुअघि नै टाइप गर्नुहोस्।</li>
    <li>प्यानलले हरेक १२ घण्टामा, र नयाँ उपकरणबाट साइन इन गर्दा नयाँ कोड माग्छ।</li>
    <li>
      नयाँ फोन लिँदै हुनुहुन्छ? पुरानो फोन रिसेट गर्नुअघि {isMaster ? 'वेबसाइट डेभलपर' : 'मास्टर एडमिन'}लाई तपाईंको two-step
      sign-in रिसेट गर्न भन्नुहोस्, अनि अर्को पटक साइन इन गर्दा नयाँ QR कोड स्क्यान गर्नुहोस्।
    </li>
  </ul>
</section>

<section id="recovery" aria-labelledby="recovery-h">
  <h2 id="recovery-h">रिकभरी कोड</h2>
  <p>
    Authenticator मिलाउँदा तपाईंले १० वटा कोड पाउनुभएको थियो। फोन हराए वा बिग्रिए हरेक कोड एक पटक, एपको कोडको सट्टा चल्छ।
    तीन वा सोभन्दा कम बाँकी रहँदा ड्यासबोर्डले सम्झाउँछ: <span class="ui">My account</span> →
    <span class="ui">Create new recovery codes</span> बाट नयाँ सेट बनाउनुहोस्। पुराना कोड चल्न छोड्छन्।
  </p>
</section>

<section id="customer-details" aria-labelledby="customer-h">
  <h2 id="customer-h">ग्राहकको विवरण</h2>
  <p>
    सोधपुछमा मानिसका नाम, फोन नम्बर, ठेगाना र गुनासो हुन्छन्। यिनलाई सोधपुछको जवाफ दिन मात्र प्रयोग गर्नुहोस्। व्यक्तिगत
    च्याटमा नसार्नुहोस्, कार्यालयबाहिर स्क्रिनसट नपठाउनुहोस्, र टोलीबाहिरका कसैलाई इमेल सूचना फरवार्ड नगर्नुहोस्।
  </p>
</section>

<section id="suspicious" aria-labelledby="suspicious-h">
  <h2 id="suspicious-h">केही शङ्कास्पद देखिए</h2>
  <p>
    आफूले नगरेको परिवर्तन, नचिनेको साइन इन, वा आफूले नमागेको कोड देखिए: पासवर्ड बदल्नुहोस्, र तुरुन्तै मास्टर एडमिनलाई
    भन्नुहोस्।
    {isMaster && ' मास्टरका रूपमा तपाईं Users बाट जोसुकैलाई सबै उपकरणबाट साइन आउट गराउन, र Activity मा हरेक साइन इन र परिवर्तन हेर्न सक्नुहुन्छ।'}
  </p>
</section>
