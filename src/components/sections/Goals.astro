---
import Icon from '~/components/Icon.astro';
import { lines, pick, type Content } from '~/lib/pages';
import type { Lang } from '~/i18n/utils';

type Props = { content: Content; lang: Lang; tone: 'white' | 'tint' };
const { content, lang, tone } = Astro.props;
const left = pick(content, 'challenges_title', lang);
const right = pick(content, 'goals_title', lang);
---

<section class:list={['section', `section-${tone}`]} aria-label={`${left} / ${right}`}>
  <div class="container lists">
    <div class="card list-card">
      <h2 class="h3"><span class="icon-tile"><Icon name="mountain" size={22} /></span> {left}</h2>
      <ol>{lines(content, 'challenges', lang).map((c) => <li>{c}</li>)}</ol>
    </div>
    <div class="card list-card goals">
      <h2 class="h3"><span class="icon-tile"><Icon name="target" size={22} /></span> {right}</h2>
      <ol>{lines(content, 'goals', lang).map((g) => <li>{g}</li>)}</ol>
    </div>
  </div>
</section>

<style>
  .lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .list-card h2 {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .list-card ol {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.4rem;
  }

  .list-card li::marker {
    color: var(--green);
    font-weight: 700;
  }

  .goals {
    background: linear-gradient(180deg, var(--green-50), #fff 50%);
    border-color: var(--green-100);
  }
</style>
