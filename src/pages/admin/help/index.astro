---
import HelpShell from '~/components/help/HelpShell.astro';
import Icon from '~/components/Icon.astro';
import { HELP_GROUP_ORDER, helpLang, readerOffice, topicHref, topicSummaryKey, topicTitleKey, topicsFor, type HelpReader } from '~/lib/help';
import { GENERAL_GROUP, helpTranslator, type HelpKey } from '~/lib/help-text';
import { ROLE_LABEL, can } from '~/lib/roles';

export const prerender = false;

// Open before sign-in too (see src/middleware.ts): new staff read Getting started before they have a login.
const me = Astro.locals.admin;
const reader: HelpReader = me ? { role: me.role, office: me.office, name: me.name, masterName: null } : null;
const lang = helpLang(Astro.url, Astro.cookies);
const t = await helpTranslator(lang);
Astro.locals.helpText = t;
const topics = topicsFor(me);
const groups = HELP_GROUP_ORDER.map((g) => ({ id: g, topics: topics.filter((tp) => tp.group === g) })).filter((g) => g.topics.length > 0);
const roleText = me
  ? me.role === 'support'
    ? `${ROLE_LABEL.support} · ${readerOffice(reader, lang) ?? t.text('shell.allOffices')}`
    : ROLE_LABEL[me.role]
  : '';
---

<HelpShell
  reader={reader}
  title={t.text(me ? 'index.titleIn' : 'index.titleOut')}
  summary={t.html(me ? 'index.summaryIn' : 'index.summaryOut')}
  editHref={`/admin/help-text?page=${GENERAL_GROUP}&lang=${lang}`}
>
  {
    me && (
      <section class="role-card" aria-labelledby="role-h">
        <h2 id="role-h">{t.text('index.yourRole', { role: roleText })}</h2>
        <p set:html={t.html(`role.${me.role}` as HelpKey)} />
        <p>
          <a href={topicHref('roles')}>{t.text('index.seeRole')}</a>
          {can(me, 'help-edit') && (
            <>
              {' · '}
              <a href={`/admin/help-text?lang=${lang}`}>{t.text('index.edit')}</a>
            </>
          )}
        </p>
      </section>
    )
  }

  {
    groups.map((g) => (
      <section aria-labelledby={`group-${g.id}`}>
        <h2 id={`group-${g.id}`}>{t.text(`group.${g.id}` as HelpKey)}</h2>
        <ul class="topic-grid">
          {g.topics.map((tp) => (
            <li>
              <a class="topic" href={topicHref(tp.slug)}>
                <span class="topic-icon" aria-hidden="true">
                  <Icon name={tp.icon} size={20} />
                </span>
                <span>
                  <strong>{t.text(topicTitleKey(tp.slug))}</strong>
                  <small set:html={t.html(topicSummaryKey(tp.slug))} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {!me && <p class="callout" set:html={t.html('index.more')} />}
</HelpShell>

<style>
  .role-card {
    padding: 1rem 1.1rem;
    border: 1px solid var(--green-200);
    border-radius: 12px;
    background: var(--green-50);
  }

  .role-card h2 {
    font-size: 1.1rem;
  }

  .topic-grid {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .topic-grid li {
    max-width: none;
  }

  .topic {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .topic:hover,
  .topic:focus-visible {
    border-color: var(--green);
    box-shadow: 0 0 0 1px var(--green);
  }

  .topic-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    background: var(--green-50);
    color: var(--green-700);
  }

  .topic strong {
    display: block;
    color: var(--ink);
  }

  .topic small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

</style>
