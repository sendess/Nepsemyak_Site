---
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/Icon.astro';
import StatusBadge from '~/components/admin/StatusBadge.astro';
import { dashboardCounts, getLiveNotices } from '~/lib/content';
import { getAllStats, STAT_GROUP_IDS } from '~/lib/stats';
import { formatDay } from '~/lib/admin-format';

export const prerender = false;

const [counts, live, stats] = await Promise.all([dashboardCounts(), getLiveNotices(), getAllStats()]);
const admin = Astro.locals.admin!;
const mediaMb = (Number(counts.media_bytes) / 1_000_000).toFixed(1);
const oldestAsOf = STAT_GROUP_IDS.map((id) => stats[id].as_of)
  .filter((d): d is string => !!d)
  .sort()[0] ?? null;

const tiles = [
  { href: '/admin/stats', icon: 'chart-bar', value: STAT_GROUP_IDS.length, label: 'Statistics groups', extra: `Oldest data: ${formatDay(oldestAsOf)}` },
  { href: '/admin/news', icon: 'newspaper', value: counts.news_published, label: 'Published news posts', extra: `${counts.news_drafts} draft(s)` },
  { href: '/admin/jobs', icon: 'briefcase', value: counts.jobs_open, label: 'Open job listings', extra: 'Shown on Careers' },
  { href: '/admin/users', icon: 'users', value: counts.admins, label: 'People with admin access', extra: `${mediaMb} MB of images stored` },
] as const;

const notices = [
  { kind: 'Banner', notice: live.banner },
  { kind: 'Pop-up', notice: live.popup },
];
---

<AdminLayout title="Dashboard">
  <p class="welcome">Namaste, {admin.name || admin.email}.</p>

  <section class="notice-card" aria-labelledby="notice-title">
    <div class="notice-lines">
      <h2 id="notice-title">Live notices</h2>
      {
        notices.map(({ kind, notice }) => (
          <p>
            <span class="kind">{kind}:</span>{' '}
            {notice ? (
              <>
                <StatusBadge status={notice.tone} />{' '}
                <a href={`/admin/notices/${notice.id}`}>{notice.title_en || notice.message_en || notice.title_ne || notice.message_ne}</a>
              </>
            ) : (
              <span class="muted">none</span>
            )}
          </p>
        ))
      }
    </div>
    <a class="btn btn-primary btn-sm" href="/admin/notices">
      <Icon name="megaphone" size={16} />
      Manage notices
    </a>
  </section>

  <div class="tiles">
    {
      tiles.map((tile) => (
        <a class="tile" href={tile.href}>
          <span class="icon-tile">
            <Icon name={tile.icon} size={22} />
          </span>
          <strong>{tile.value}</strong>
          <span>{tile.label}</span>
          <small>{tile.extra}</small>
        </a>
      ))
    }
  </div>

  <section class="form-section quick">
    <h2>Quick actions</h2>
    <div class="quick-links">
      <a class="btn btn-ghost" href="/admin/news/new"><Icon name="newspaper" size={18} /> Write a news post</a>
      <a class="btn btn-ghost" href="/admin/jobs/new"><Icon name="briefcase" size={18} /> Add a job</a>
      <a class="btn btn-ghost" href="/admin/notices#new"><Icon name="megaphone" size={18} /> Post a notice</a>
    </div>
    <p class="hint">
      Changes appear on the website within a few seconds of saving. Everything can be written in English, Nepali or both —
      if one language is empty, visitors see the other.
    </p>
  </section>
</AdminLayout>

<style>
  .welcome {
    margin-bottom: 1.25rem;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .notice-card {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--yellow);
  }

  .notice-card p {
    margin-top: 0.35rem;
  }

  .kind {
    display: inline-block;
    min-width: 4.2rem;
    font-weight: 600;
    color: var(--ink);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .tile {
    display: grid;
    gap: 0.2rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s var(--ease);
  }

  .tile:hover {
    border-color: var(--green-200);
    transform: translateY(-2px);
    color: var(--muted);
  }

  .tile .icon-tile {
    margin-bottom: 0.5rem;
  }

  .tile strong {
    font-family: var(--font-head);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--green-700);
  }

  .tile span {
    color: var(--ink);
    font-weight: 600;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
