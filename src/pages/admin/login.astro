---
import AuthLayout from '~/layouts/AuthLayout.astro';
import { safeNext } from '~/lib/admin-routes';

export const prerender = false;

// The middleware sends anyone further along (password already accepted) to their next step.
const auth = Astro.locals.auth;
const next = safeNext(Astro.url.searchParams.get('next'));
const notAdmin = auth?.stage === 'not-admin';
const resetDone = Astro.url.searchParams.has('reset');
---

<AuthLayout title="Sign in">
  {
    notAdmin ? (
      <section class="step">
        <h1 class="h3">No admin access</h1>
        <p>
          <strong>{auth?.email}</strong> is signed in but is not an admin. Ask the master admin to add you.
        </p>
        <button class="btn btn-primary" type="button" data-sign-out>
          Sign out
        </button>
      </section>
    ) : (
      <section class="step">
        <h1 class="h3">Sign in</h1>
        {resetDone && <p class="message ok">Password saved. Sign in with your new password.</p>}
        <form data-login>
          <div class="field">
            <label for="email">Email</label>
            <input class="input" id="email" name="email" type="email" autocomplete="username" required />
          </div>
          <div class="field">
            <div class="field-row">
              <label for="password">Password</label>
              <a class="hint" href="/admin/reset-password">
                Forgot password?
              </a>
            </div>
            <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
          </div>
          <button class="btn btn-primary" type="submit">
            Continue
          </button>
        </form>
        <p class="message" data-message role="alert" />
        <p class="hint">
          Next you’ll enter the 6-digit code from your authenticator app. New admin?{' '}
          <a href="/admin/reset-password">Set your password</a> first, or read the{' '}
          <a href="/admin/help#first-sign-in">getting-started guide</a>.
        </p>
      </section>
    )
  }

  <script define:vars={{ next }}>
  const form = document.querySelector('[data-login]');
  const message = document.querySelector('[data-message]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button');
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    message.textContent = '';
    const res = await fetch('/api/auth/sign-in/email', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ email: form.email.value.trim().toLowerCase(), password: form.password.value }),
    }).catch(() => null);
    if (res?.ok) {
      location.href = next;
      return;
    }
    const data = (await res?.json().catch(() => null)) ?? {};
    button.disabled = false;
    button.removeAttribute('aria-busy');
    form.password.value = '';
    message.textContent = data.message ?? 'Could not sign in. Check your connection and try again.';
  });
</script>
</AuthLayout>
