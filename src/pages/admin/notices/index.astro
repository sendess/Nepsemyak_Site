---
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/Icon.astro';
import StatusBadge from '~/components/admin/StatusBadge.astro';
import { listNotices, type Notice } from '~/lib/content';
import { formatNpt } from '~/lib/admin-format';

export const prerender = false;

const notices = await listNotices();
const now = Date.now();
const state = (n: Notice) => {
  if (!n.is_active) return 'inactive';
  if (Date.parse(n.starts_at) > now) return 'scheduled';
  if (n.ends_at && Date.parse(n.ends_at) <= now) return 'expired';
  return 'active';
};
const flash = Astro.url.searchParams.get('done');
---

<AdminLayout title="Notices" wide>
  {flash && <p class="flash"><Icon name="circle-check" size={20} /> Notice {flash}. The website updates within seconds.</p>}

  <div class="toolbar">
    <p class="hint">
      Show a <strong>banner</strong> at the top of every page, a <strong>pop-up</strong> when visitors arrive, or both. The
      newest active notice of each kind is shown.
    </p>
    <a class="btn btn-primary" href="/admin/notices/new" id="new"><Icon name="megaphone" size={18} /> New notice</a>
  </div>

  {
    notices.length === 0 ? (
      <div class="empty-state">
        <Icon name="megaphone" size={32} />
        <p>No notices yet.</p>
      </div>
    ) : (
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th scope="col">Message</th>
              <th scope="col">Shown as</th>
              <th scope="col">Type</th>
              <th scope="col">Status</th>
              <th scope="col">Showing</th>
            </tr>
          </thead>
          <tbody>
            {notices.map((n) => (
              <tr>
                <td class="msg">
                  {n.image_media_id && <img src={`/media/${n.image_media_id}`} alt="" width="48" height="36" loading="lazy" />}
                  <a href={`/admin/notices/${n.id}`}>{n.title_en || n.title_ne || n.message_en || n.message_ne}</a>
                </td>
                <td class="nowrap">
                  {n.show_banner && <span class="chip">Banner</span>}
                  {n.show_popup && <span class="chip">Pop-up</span>}
                </td>
                <td>
                  <StatusBadge status={n.tone} />
                </td>
                <td>
                  <StatusBadge status={state(n)} />
                </td>
                <td class="hint">
                  {formatNpt(n.starts_at)} → {n.ends_at ? formatNpt(n.ends_at) : 'until turned off'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<style>
  .msg {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .msg img {
    flex: none;
    width: 48px;
    height: 36px;
    border-radius: 6px;
    object-fit: cover;
  }

  .nowrap {
    white-space: nowrap;
  }

  .chip {
    display: inline-block;
    margin-inline-end: 0.3rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--ink);
  }
</style>
