---
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/Icon.astro';
import StatusBadge from '~/components/admin/StatusBadge.astro';
import {
  addNote,
  adminName,
  assigneesFor,
  deleteRequest,
  getRequest,
  listHandovers,
  listNotes,
  recordHandover,
  requestInScope,
  updateRequest,
  REQUEST_STATUSES,
  STATUS_LABEL,
  TOPIC_LABEL,
  type RequestStatus,
} from '~/lib/requests';
import { can, officeName, officeScope, isOffice } from '~/lib/roles';
import { requestActor } from '~/lib/audit';
import { branches } from '~/data/site';
import { formatNpt, parseId } from '~/lib/admin-format';
import { paragraphs } from '~/lib/forms';
import { telHref } from '~/i18n/utils';
import { alertAssigned, alertFor, alertHandover, officeRecipients } from '~/lib/notify';
import { afterResponse } from '~/lib/background';

export const prerender = false;

const me = Astro.locals.admin!;
const myName = me.name || me.email;
const canDelete = can(me, 'requests.delete');
const canHandle = can(me, 'requests.handle');
const scope = officeScope(me);

const id = parseId(Astro.params.id);
if (typeof id !== 'number') return Astro.redirect('/admin/requests', 303);
const request = await getRequest(id);
// Customer care for one office can't open other offices' queries, even with a direct link.
if (!request || !requestInScope(scope, request)) return Astro.redirect('/admin/requests', 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const actor = requestActor(Astro, me.email);
  const action = form.get('_action');

  if (action === 'delete') {
    // Only the master admin may remove a message for good.
    if (!canDelete) return Astro.redirect(`/admin/requests/${request.id}`, 303);
    await deleteRequest(request.id, actor);
    return Astro.redirect('/admin/requests?done=deleted', 303);
  }

  // Viewers read queries but can't change them (the middleware stops them too).
  if (!canHandle) return Astro.redirect(`/admin/requests/${request.id}`, 303);

  if (action === 'take') {
    await updateRequest(request.id, request.status, request.branch, me.email, actor);
    return Astro.redirect(`/admin/requests/${request.id}?saved=1`, 303);
  }

  const statusValue = String(form.get('status') ?? '');
  const status = (REQUEST_STATUSES as readonly string[]).includes(statusValue) ? (statusValue as RequestStatus) : request.status;
  const branchValue = String(form.get('branch') ?? '');
  const branch = isOffice(branchValue) ? branchValue : null;
  const note = String(form.get('note') ?? '').trim().slice(0, 2000);

  // Only someone who can see the query's (new) office can be given it; anyone else is cleared.
  const eligible = await assigneesFor(branch);
  const chosen = String(form.get('assigned_to') ?? '');
  let assignedTo = eligible.some((a) => a.email === chosen) ? chosen : null;
  // Whoever first marks an unassigned query In progress takes it on.
  if (!assignedTo && !request.assigned_to && status === 'in_progress' && request.status !== 'in_progress' && eligible.some((a) => a.email === me.email)) {
    assignedTo = me.email;
  }

  const moved = branch !== request.branch;
  if (status !== request.status || moved || assignedTo !== request.assigned_to) {
    await updateRequest(request.id, status, branch, assignedTo, actor);
  }
  if (note) await addNote(request.id, note, actor);
  const updated = (await getRequest(request.id))!;

  // Passed to another office: record it, and tell that office's Customer care (or warn that nobody there is told).
  let nobodyAt: string | null = null;
  if (moved) {
    const handoverId = await recordHandover(request.id, request.branch, branch, me.email, note || null);
    if (branch) {
      const to = (await officeRecipients(branch)).filter((email) => email !== me.email);
      if (to.length === 0) nobodyAt = branch;
      else await afterResponse(Astro.locals, alertHandover(updated, handoverId, to, { name: myName, fromOffice: request.branch, note: note || null }));
    }
  }
  if (assignedTo && assignedTo !== request.assigned_to && assignedTo !== me.email) {
    await afterResponse(Astro.locals, alertAssigned(updated, assignedTo, myName));
  }

  const warn = nobodyAt ? `&nobody=${nobodyAt}` : '';
  // Moved to an office this person doesn't look after: it now belongs to that office's staff.
  if (!requestInScope(scope, updated)) return Astro.redirect(`/admin/requests?done=moved${warn}`, 303);
  return Astro.redirect(`/admin/requests/${request.id}?saved=1${warn}`, 303);
}

const [notes, alert, handovers, assignees, assignedName] = await Promise.all([
  listNotes(request.id),
  alertFor(request.id),
  listHandovers(request.id),
  canHandle ? assigneesFor(request.branch) : Promise.resolve([]),
  adminName(request.assigned_to),
]);
const saved = Astro.url.searchParams.has('saved');
const nobodyParam = Astro.url.searchParams.get('nobody') ?? '';
const nobodyAt = isOffice(nobodyParam) ? officeName(nobodyParam) : null;
const branchName = (bid: string | null) => branches.find((b) => b.id === bid)?.name.en ?? 'Not sure';
const waitingSince = Math.round((Date.now() - Date.parse(request.created_at)) / 3_600_000);
const canTake = canHandle && request.assigned_to !== me.email && assignees.some((a) => a.email === me.email);
// Keep someone listed even if they could no longer be chosen, so saving doesn't silently clear them.
const assigneeOptions =
  request.assigned_to && !assignees.some((a) => a.email === request.assigned_to)
    ? [...assignees, { email: request.assigned_to, name: assignedName ?? request.assigned_to }]
    : assignees;
const nameFor = new Map(assigneeOptions.map((a) => [a.email, a.name || a.email]));
---

<AdminLayout title={`Request ${request.ref}`}>
  {saved && <p class="flash"><Icon name="circle-check" size={20} /> Saved.</p>}
  {
    nobodyAt && (
      <p class="flash error">
        Nobody at {nobodyAt} receives email alerts yet, so they haven’t been told about this query. Please phone them.
      </p>
    )
  }

  <div class="toolbar">
    <a class="link-arrow" href="/admin/requests"><Icon name="arrow-left" size={16} /> All requests</a>
    <span class="toolbar-right">
      <span class="assignee">
        <Icon name="users" size={16} /> {request.assigned_to ? (request.assigned_to === me.email ? 'Assigned to you' : `Assigned to ${assignedName}`) : 'Not assigned yet'}
      </span>
      {
        canTake && (
          <form method="post">
            <input type="hidden" name="_action" value="take" />
            <button class="btn btn-ghost btn-sm" type="submit">Assign to me</button>
          </form>
        )
      }
      <StatusBadge status={request.status} label={STATUS_LABEL[request.status]} />
    </span>
  </div>

  <div class="grid">
    <div class="stack">
      <section class="form-section">
        <h2>{TOPIC_LABEL[request.topic]}</h2>
        <p class="hint">
          {request.ref} · received {formatNpt(request.created_at)}
          {request.status === 'new' && waitingSince >= 1 && ` · waiting ${waitingSince} hour${waitingSince === 1 ? '' : 's'}`}
          {request.language === 'ne' && ' · written on the Nepali site'}
        </p>
        {
          alert && (
            <p class:list={['hint', { 'alert-failed': alert.error }]}>
              <Icon name="mail" size={16} />{' '}
              {alert.error
                ? `The email alert could not be sent: ${alert.error}`
                : alert.sent_to
                  ? `Email alert sent to ${alert.sent_to} admin${alert.sent_to === 1 ? '' : 's'}.`
                  : 'No email alert went out: nobody had alerts turned on.'}
            </p>
          )
        }
        <div class="message">
          {paragraphs(request.message).map((lines) => (
            <p>
              {lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          ))}
        </div>
      </section>

      {!canHandle && (
        <p class="hint read-only">
          <Icon name="eye" size={16} /> You can read this query but not change it. Status:{' '}
          <strong>{STATUS_LABEL[request.status]}</strong>.
        </p>
      )}

      <section class="form-section" hidden={!canHandle}>
        <h2>What happens next</h2>
        <form method="post" class="form-grid">
          <div class="row-2">
            <div class="field">
              <label for="status">Status</label>
              <select class="select" id="status" name="status">
                {REQUEST_STATUSES.map((s) => (
                  <option value={s} selected={request.status === s}>
                    {STATUS_LABEL[s]}
                  </option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="branch">Office dealing with it</label>
              <select class="select" id="branch" name="branch">
                <option value="">Not sure / head office</option>
                {branches.map((b) => (
                  <option value={b.id} selected={request.branch === b.id}>
                    {b.name.en}
                  </option>
                ))}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="assigned_to">Assigned to</label>
            <select class="select" id="assigned_to" name="assigned_to">
              <option value="">Nobody yet</option>
              {assigneeOptions.map((a) => (
                <option value={a.email} selected={request.assigned_to === a.email}>
                  {a.email === me.email ? `${a.name || a.email} (you)` : a.name || a.email}
                </option>
              ))}
            </select>
            <p class="hint">
              The person dealing with it. If nobody is chosen when you mark it In progress, it’s assigned to you. Moving it to
              an office they don’t cover clears it.
            </p>
          </div>
          <div class="field">
            <label for="note">Add a note (optional)</label>
            <textarea class="textarea" id="note" name="note" rows="3" maxlength="2000" placeholder="Called the customer, collection arranged for Sunday…"></textarea>
            <p class="hint">
              Notes stay in the admin panel; the person who wrote in doesn’t see them. When you move the query to another
              office, this note is included in the email to that office.
            </p>
          </div>
          <button class="btn btn-primary" type="submit"><Icon name="check" size={18} /> Save</button>
        </form>
      </section>

      {
        canDelete && (
          <section class="form-section danger">
            <h2>Delete this message</h2>
            <p class="hint">
              Only you, as master admin, can delete messages. Others can mark them as spam instead. A deleted message
              still appears in the <a href="/admin/activity">activity log</a>, so the record is never lost.
            </p>
            <form method="post" data-confirm={`Delete the message from ${request.name} (${request.ref})? This cannot be undone.`}>
              <input type="hidden" name="_action" value="delete" />
              <button class="btn btn-danger" type="submit">
                <Icon name="trash" size={18} /> Delete message
              </button>
            </form>
          </section>
        )
      }

      {
        notes.length > 0 && (
          <section class="form-section">
            <h2>Notes</h2>
            <ol class="notes">
              {notes.map((n) => (
                <li>
                  <p class="hint">
                    {formatNpt(n.at)} · {n.author_email ?? 'system'}
                  </p>
                  <p>{n.note}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }

    {
      handovers.length > 0 && (
        <section class="form-section handovers">
          <h2>Passed between offices</h2>
          <ol class="notes">
            {handovers.map((h) => (
              <li>
                <p class="hint">
                  {formatNpt(h.at)} · {h.by_email ? (nameFor.get(h.by_email) ?? h.by_email) : 'system'}
                </p>
                <p>
                  {branchName(h.from_branch)} → <strong>{branchName(h.to_branch)}</strong>
                  {h.note && <span class="muted"> · “{h.note}”</span>}
                </p>
                <p class="hint">
                  {!h.to_branch
                    ? 'No office chosen.'
                    : h.error
                      ? `The email to that office failed: ${h.error}`
                      : h.sent_to
                        ? `Emailed ${h.sent_to} ${h.sent_to === 1 ? 'person' : 'people'} there.`
                        : 'Nobody there receives email alerts.'}
                </p>
              </li>
            ))}
          </ol>
        </section>
      )
    }
    </div>

    <aside class="form-section who">
      <h2>Who wrote in</h2>
      <p><strong>{request.name}</strong></p>
      <p class="line">
        <Icon name="phone" size={18} />
        <a href={telHref(request.phone)}>{request.phone}</a>
      </p>
      {
        request.email && (
          <p class="line">
            <Icon name="mail" size={18} />
            <a href={`mailto:${request.email}?subject=${encodeURIComponent(`Nepsemyak — your message ${request.ref}`)}`}>{request.email}</a>
          </p>
        )
      }
      {
        request.address && (
          <p class="line">
            <Icon name="map-pin" size={18} />
            {request.address}
          </p>
        )
      }
      <p class="line">
        <Icon name="building" size={18} />
        {branchName(request.branch)}
      </p>
      {
        request.handled_by && (
          <p class="hint">
            Last updated by {request.handled_by}
            {request.handled_at && ` on ${formatNpt(request.handled_at)}`}
          </p>
        )
      }
      <p class="hint">
        Sent from {request.ip ?? 'unknown address'}
      </p>
    </aside>
  </div>
</AdminLayout>

<style>
  .alert-failed {
    color: #a61b1b;
  }

  .toolbar-right {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  .assignee {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .muted {
    color: var(--muted);
  }

  .read-only {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--surface);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .stack {
    display: grid;
    gap: 1.25rem;
  }

  .message {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: var(--green-50);
    overflow-wrap: anywhere;
  }

  .notes {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes li {
    padding-left: 0.9rem;
    border-left: 3px solid var(--green-200);
  }

  .notes p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .danger {
    border-color: #f3c4bf;
  }

  .who {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .who p {
    margin: 0;
  }

  .line {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    overflow-wrap: anywhere;
  }

  .line :global(.icon) {
    flex: none;
    color: var(--green);
  }
</style>
