---
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/Icon.astro';
import StatusBadge from '~/components/admin/StatusBadge.astro';
import SortTh from '~/components/admin/SortTh.astro';
import ListControls from '~/components/admin/ListControls.astro';
import Pager from '~/components/admin/Pager.astro';
import { listRequests, REQUEST_LIST, REQUEST_STATUSES, REQUEST_TOPICS, STATUS_LABEL, TOPIC_LABEL } from '~/lib/requests';
import { isFiltered, listHref, readList } from '~/lib/listing';
import { branches } from '~/data/site';
import { formatNpt } from '~/lib/admin-format';
import { can, isOffice, officeName, officeScope } from '~/lib/roles';
import { listAdmins } from '~/lib/content';

export const prerender = false;

const me = Astro.locals.admin!;
const scope = officeScope(me);
const list = readList(Astro.url, Astro.cookies, REQUEST_LIST);
const [{ rows, total }, admins] = await Promise.all([listRequests(list, scope, me.email), listAdmins()]);
const nameOf = new Map(admins.map((a) => [a.email, a.name || a.email]));
const handles = can(me, 'requests.handle');
/** "Passed from Lalitpur · 3 h ago" for queries handed over in the last week. */
const passedLabel = (at: string | null, from: string | null) => {
  if (!at) return null;
  const hours = (Date.now() - Date.parse(at)) / 3_600_000;
  if (hours > 24 * 7) return null;
  const ago = hours < 1 ? 'just now' : hours < 48 ? `${Math.round(hours)} h ago` : `${Math.round(hours / 24)} days ago`;
  return `Passed from ${from ? (officeName(from) ?? 'another office') : 'no office'} · ${ago}`;
};
if (rows.length === 0 && list.page > 1) return Astro.redirect(listHref(list, { page: 1 }));

const branchName = (id: string | null) => branches.find((b) => b.id === id)?.name.en ?? 'Not sure';
const DONE: Record<string, string> = {
  deleted: 'Request deleted.',
  moved: 'Request moved to another office. Staff there will take it from here.',
};
const flash = DONE[Astro.url.searchParams.get('done') ?? ''];
const nobodyParam = Astro.url.searchParams.get('nobody') ?? '';
const nobodyAt = isOffice(nobodyParam) ? officeName(nobodyParam) : null;
// Customer care for one office only chooses between that office and “Not sure”.
const officeOptions = [...branches.filter((b) => !scope || b.id === scope).map((b) => ({ value: b.id, label: b.name.en })), { value: 'unsure', label: 'Not sure' }];
---

<AdminLayout title="Requests" wide>
  {flash && <p class="flash"><Icon name="circle-check" size={20} /> {flash}</p>}
  {nobodyAt && <p class="flash error">Nobody at {nobodyAt} receives email alerts yet, so they haven’t been told. Please phone them.</p>}

  <div class="toolbar">
    <p class="hint">
      Queries and complaints sent from the website’s contact form. Newest first.
      {scope && ` Showing ${officeName(scope)} and queries where the customer didn’t choose an office.`}
    </p>
  </div>

  {
    total === 0 && !isFiltered(list) ? (
      <div class="empty-state">
        <Icon name="messages-square" size={32} />
        <p>No messages yet. They arrive here as soon as someone uses the contact form.</p>
      </div>
    ) : (
      <>
        <ListControls
          list={list}
          searchLabel="Search name, phone, message, reference"
          filters={[
            { name: 'status', all: 'All statuses', options: REQUEST_STATUSES.map((s) => ({ value: s, label: STATUS_LABEL[s] })) },
            { name: 'topic', all: 'All topics', options: REQUEST_TOPICS.map((t) => ({ value: t, label: TOPIC_LABEL[t] })) },
            {
              name: 'branch',
              all: 'All offices',
              options: officeOptions,
            },
            ...(handles
              ? [
                  {
                    name: 'assigned' as const,
                    all: 'Anyone',
                    options: [
                      { value: 'me', label: 'My queries' },
                      { value: 'none', label: 'Not assigned yet' },
                    ],
                  },
                ]
              : []),
          ]}
        />
        {total === 0 ? (
          <div class="empty-state">
            <Icon name="search" size={32} />
            <p>No messages match this search or filter.</p>
          </div>
        ) : (
          <div class="table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <SortTh list={list} sort="received" label="Received" />
                  <SortTh list={list} sort="name" label="From" />
                  <SortTh list={list} sort="topic" label="About" />
                  <SortTh list={list} sort="branch" label="Office" />
                  <SortTh list={list} sort="status" label="Status" />
                  <th scope="col">Assigned to</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class:list={{ unread: r.status === 'new' }}>
                    <td class="nowrap">
                      <a href={`/admin/requests/${r.id}`}>{formatNpt(r.created_at)}</a>
                      <small class="sub">{r.ref}</small>
                    </td>
                    <td>
                      <strong>{r.name}</strong>
                      <small class="sub">{r.phone}</small>
                    </td>
                    <td>
                      {TOPIC_LABEL[r.topic]}
                      <small class="sub message">{r.message}</small>
                    </td>
                    <td class="hint">
                      {branchName(r.branch)}
                      {passedLabel(r.passed_at, r.passed_from) && <small class="sub passed">{passedLabel(r.passed_at, r.passed_from)}</small>}
                    </td>
                    <td>
                      <StatusBadge status={r.status} label={STATUS_LABEL[r.status]} />
                    </td>
                    <td class="hint">{r.assigned_to ? (r.assigned_to === me.email ? 'You' : (nameOf.get(r.assigned_to) ?? r.assigned_to)) : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <Pager list={list} total={total} noun={['message', 'messages']} />
      </>
    )
  }
</AdminLayout>

<style>
  .nowrap {
    white-space: nowrap;
  }

  .sub {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .message {
    display: -webkit-box;
    max-width: 28rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .passed {
    color: var(--green-700);
    font-weight: 600;
  }

  .unread strong,
  .unread a {
    font-weight: 700;
  }

  .unread td:first-child {
    box-shadow: inset 3px 0 0 var(--green);
  }
</style>
