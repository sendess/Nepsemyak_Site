---
import AuthLayout from '~/layouts/AuthLayout.astro';
import { PASSWORD_MIN_LENGTH } from '~/lib/auth';

export const prerender = false;
---

<AuthLayout title="Set password">
  <section class="step" data-step="email">
    <h1 class="h3">Set or reset your password</h1>
    <p class="muted">Enter your admin email. We’ll email you a 6-digit code to choose a new password.</p>
    <form data-request>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="username" required />
      </div>
      <button class="btn btn-primary" type="submit">Email me a code</button>
    </form>
    <a class="link" href="/admin/login">Back to sign in</a>
  </section>

  <section class="step" data-step="password" hidden>
    <h1 class="h3">Choose a password</h1>
    <p class="muted">
      If <strong data-email-echo></strong> is an admin, a code is on its way. It can take a minute — check spam too.
    </p>
    <form data-reset>
      <div class="field">
        <label for="otp">Code from the email</label>
        <input class="input code-input" id="otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
      </div>
      <div class="field">
        <label for="password">New password</label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength={PASSWORD_MIN_LENGTH} maxlength="128" required />
        <p class="hint">At least {PASSWORD_MIN_LENGTH} characters. A few unrelated words make a strong, memorable password.</p>
      </div>
      <div class="field">
        <label for="confirm">Type it again</label>
        <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required />
      </div>
      <button class="btn btn-primary" type="submit">Save password</button>
      <button class="link" type="button" data-back>Send a new code</button>
    </form>
  </section>

  <p class="message" data-message role="alert"></p>
</AuthLayout>

<script>
  const message = document.querySelector<HTMLElement>('[data-message]')!;
  const show = (step: string) => {
    document.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => (el.hidden = el.dataset.step !== step));
    message.textContent = '';
  };
  const post = async (path: string, body: unknown) => {
    const res = await fetch(`/api/auth/${path}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    }).catch(() => null);
    const data = (await res?.json().catch(() => null)) ?? {};
    return { ok: Boolean(res?.ok), message: data.message as string | undefined };
  };
  let email = '';

  const requestForm = document.querySelector<HTMLFormElement>('[data-request]')!;
  requestForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = requestForm.querySelector('button')!;
    button.disabled = true;
    email = (requestForm.elements.namedItem('email') as HTMLInputElement).value.trim().toLowerCase();
    const result = await post('email-otp/request-password-reset', { email });
    button.disabled = false;
    if (!result.ok) {
      message.textContent = result.message ?? 'Could not send a code. Try again in a minute.';
      return;
    }
    document.querySelector('[data-email-echo]')!.textContent = email;
    show('password');
    document.getElementById('otp')?.focus();
  });

  const resetForm = document.querySelector<HTMLFormElement>('[data-reset]')!;
  resetForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const field = (name: string) => resetForm.elements.namedItem(name) as HTMLInputElement;
    if (field('password').value !== field('confirm').value) {
      message.textContent = 'The two passwords don’t match.';
      return;
    }
    const button = resetForm.querySelector<HTMLButtonElement>('button[type=submit]')!;
    button.disabled = true;
    const result = await post('email-otp/reset-password', { email, otp: field('otp').value.trim(), password: field('password').value });
    button.disabled = false;
    if (result.ok) {
      location.href = '/admin/login?reset=1';
      return;
    }
    message.textContent = result.message ?? 'Could not save the password. Try again.';
  });

  document.querySelector('[data-back]')?.addEventListener('click', () => show('email'));
</script>
