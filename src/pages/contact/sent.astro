import View from '~/views/ContactSent.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title={t('contact.sentTitle')} description={t('contact.sentText')} noindex>
  <View lang={lang} />
</BaseLayout>
