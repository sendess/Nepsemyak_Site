---
import BaseLayout from '~/layouts/BaseLayout.astro';
import View from '~/views/Faq.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title={t('faq.title')} description={t('faq.intro')}>
  <View lang={lang} />
</BaseLayout>
