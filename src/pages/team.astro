---
import BaseLayout from '~/layouts/BaseLayout.astro';
import View from '~/views/Team.astro';
import { cachePublic } from '~/lib/cache';
import { getPageSections } from '~/lib/pages';
import { useTranslations } from '~/i18n/utils';

// Content is edited in the admin panel; the page is cached until someone saves a change.
export const prerender = false;

const lang = 'en';
const t = useTranslations(lang);
const sections = await getPageSections('team');
cachePublic(Astro.response.headers, ['content']);
---

<BaseLayout title={t('team.title')} description={t('team.intro')}>
  <View lang={lang} sections={sections} />
</BaseLayout>
