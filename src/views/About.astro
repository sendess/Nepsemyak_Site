---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import PageHero from '~/components/PageHero.astro';
import SectionHead from '~/components/SectionHead.astro';
import YouTube from '~/components/YouTube.astro';
import CtaBand from '~/components/CtaBand.astro';
import chairmanPhoto from '~/assets/images/chairman.jpg';
import { org } from '~/data/site';
import { aboutIntro, vision, mission, milestones, beforeList, achievements, challenges, longTermGoals, chairman } from '~/data/about';
import { formatNumber, localizePath, useTranslations, yearsSince, type Lang } from '~/i18n/utils';
import type { IconName } from '~/components/icons';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = (path: string) => localizePath(path, lang);

const yearsOfService = yearsSince(org.establishedOn);
const yearsOfExperience = yearsSince(org.experienceSince);

const next: { path: string; icon: IconName; title: string; desc: string }[] = [
  { path: '/team', icon: 'users', title: t('nav.team'), desc: t('nav.teamDesc') },
  { path: '/impact', icon: 'chart-bar', title: t('nav.impact'), desc: t('nav.impactDesc') },
  { path: '/services', icon: 'truck', title: t('nav.services'), desc: t('home.services.title') },
];
---

<PageHero lang={lang} title={t('about.title')} lead={t('about.intro')} />

<section class="section section-white">
  <div class="container intro-grid">
    <div class="stack" style="--stack: 1.25rem">
      <span class="eyebrow">{t('home.about.eyebrow')}</span>
      <h2 class="h2">{org.legalName[lang]}</h2>
      {aboutIntro.map((p) => <p class="lead">{p[lang]}</p>)}
      <div class="years">
        <div>
          <strong>{formatNumber(yearsOfService, lang)}</strong>
          <span>{t('about.yearsService')}</span>
        </div>
        <div>
          <strong>{formatNumber(yearsOfExperience, lang)}</strong>
          <span>{t('about.yearsExperience')}</span>
        </div>
      </div>
    </div>
    <div class="vm">
      <article class="vm-card reveal">
        <span class="icon-tile lg solid"><Icon name="eye" size={26} /></span>
        <h3 class="h3">{t('about.visionTitle')}</h3>
        <p>{vision[lang]}</p>
      </article>
      <article class="vm-card mission reveal">
        <span class="icon-tile lg solid"><Icon name="target" size={26} /></span>
        <h3 class="h3">{t('about.missionTitle')}</h3>
        <p>{mission[lang]}</p>
      </article>
    </div>
  </div>
</section>

<section class="section section-tint" aria-labelledby="timeline-title">
  <div class="container">
    <SectionHead title={t('about.timelineTitle')} id="timeline-title" center />
    <ol class="timeline">
      {
        milestones.map((m) => (
          <li class="reveal">
            <span class="t-year">{m.year[lang]}</span>
            <div class="card">
              <h3 class="h4">{m.title[lang]}</h3>
              <p>{m.text[lang]}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="video reveal">
      <YouTube id={org.youtubeVideoId} title={t('home.about.videoTitle')} label={t('home.about.video')} />
    </div>
  </div>
</section>

<section class="section section-white" aria-labelledby="change-title">
  <div class="container">
    <SectionHead title={t('about.beforeAfterTitle')} id="change-title" />
    <div class="compare">
      <div class="compare-col before reveal">
        <h3 class="h4"><Icon name="circle-x" size={22} /> {t('about.before')}</h3>
        <ul>{beforeList.map((b) => <li>{b[lang]}</li>)}</ul>
      </div>
      <div class="compare-col after reveal">
        <h3 class="h4"><Icon name="circle-check" size={22} /> {t('about.now')}</h3>
        <ul>{achievements.map((a) => <li>{a[lang]}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint" id="chairman" aria-labelledby="chairman-title">
  <div class="container letter">
    <aside class="letter-side">
      <div class="photo">
        <Image src={chairmanPhoto} alt={chairman.name[lang]} width={520} widths={[320, 520]} sizes="(max-width: 860px) 60vw, 320px" />
      </div>
      <p class="sig-name">{chairman.name[lang]}</p>
      <p class="sig-role">{chairman.role[lang]}</p>
    </aside>
    <article class="letter-body">
      <span class="eyebrow">{t('home.chairman.eyebrow')}</span>
      <h2 class="h2" id="chairman-title">{t('about.chairmanTitle')}</h2>
      <p class="pull"><Icon name="quote" size={28} /> {chairman.excerpt[lang]}</p>
      {chairman.message.map((p) => <p>{p[lang]}</p>)}
      <p class="signoff">{chairman.signoff[lang]}</p>
    </article>
  </div>
</section>

<section class="section section-white" aria-label={`${t('about.challengesTitle')} / ${t('about.goalsTitle')}`}>
  <div class="container lists">
    <div class="card list-card">
      <h2 class="h3"><span class="icon-tile"><Icon name="mountain" size={22} /></span> {t('about.challengesTitle')}</h2>
      <ol>{challenges.map((c) => <li>{c[lang]}</li>)}</ol>
    </div>
    <div class="card list-card goals">
      <h2 class="h3"><span class="icon-tile"><Icon name="target" size={22} /></span> {t('about.goalsTitle')}</h2>
      <ol>{longTermGoals.map((g) => <li>{g[lang]}</li>)}</ol>
    </div>
  </div>
</section>

<section class="section section-tint" aria-labelledby="next-title">
  <div class="container">
    <SectionHead title={t('about.nextTitle')} id="next-title" />
    <div class="grid grid-3">
      {
        next.map((n) => (
          <a class="card card-hover next" href={href(n.path)}>
            <span class="icon-tile lg"><Icon name={n.icon} size={26} /></span>
            <span class="h4 next-title">{n.title}</span>
            <span class="muted">{n.desc}</span>
            <Icon name="arrow-right" size={20} class="next-arrow" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<CtaBand lang={lang} />

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .years {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .years div {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--green-50);
    border: 1px solid var(--green-100);
  }

  .years strong {
    font-family: var(--font-head);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--green-700);
  }

  .years span {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .vm {
    display: grid;
    gap: 1.25rem;
  }

  .vm-card {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--green-bright), var(--green));
    color: #f0f8ec;
    box-shadow: var(--shadow);
  }

  .vm-card.mission {
    background: linear-gradient(135deg, var(--navy), var(--slate));
    color: #e6e9f0;
  }

  .vm-card h3 {
    color: #fff;
  }

  .vm-card :global(.icon-tile.solid) {
    background: rgb(255 255 255 / 0.18);
  }

  /* Timeline */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(to right, var(--green-200), var(--green), var(--slate));
    border-radius: 3px;
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .t-year {
    position: relative;
    justify-self: start;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--green-900);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.25rem;
    box-shadow: 0 0 0 6px var(--green-50);
  }

  .timeline .card {
    display: grid;
    gap: 0.5rem;
  }

  .timeline .card p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: 1fr;
      padding-left: 1.5rem;
    }

    .timeline::before {
      top: 0;
      bottom: 0;
      left: 0.35rem;
      right: auto;
      width: 3px;
      height: auto;
      background: linear-gradient(to bottom, var(--green-200), var(--green), var(--slate));
    }
  }

  .video {
    max-width: 860px;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
  }

  /* Before / after */
  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
  }

  .compare-col {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
  }

  .compare-col h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .compare-col ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .compare-col li {
    position: relative;
    padding-left: 1.5rem;
  }

  .compare-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .before {
    background: #f3f2f6;
    color: var(--slate-700);
  }

  .before h3 {
    color: var(--slate);
  }

  .before li::before {
    background: var(--slate);
    opacity: 0.5;
  }

  .after {
    background: var(--green-50);
    border: 1px solid var(--green-100);
  }

  .after h3 {
    color: var(--green-700);
  }

  .after li::before {
    background: var(--green);
  }

  /* Chairman letter */
  .letter {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .letter {
      grid-template-columns: 1fr;
    }

    .letter-side {
      max-width: 320px;
    }
  }

  .letter-side {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 20%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .sig-name {
    margin-top: 1.25rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--navy);
  }

  .sig-role {
    color: var(--muted);
  }

  .letter-body {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .pull {
    display: flex;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--green);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--green-50);
    font-family: var(--font-head);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.4;
    color: var(--navy);
  }

  :global(:lang(ne)) .pull {
    font-family: var(--font-sans);
  }

  .pull :global(.icon) {
    flex: none;
    color: var(--green);
  }

  .signoff {
    font-weight: 600;
    color: var(--ink);
  }

  /* Challenges & goals */
  .lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .list-card h2 {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .list-card ol {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.4rem;
  }

  .list-card li::marker {
    color: var(--green);
    font-weight: 700;
  }

  .goals {
    background: linear-gradient(180deg, var(--green-50), #fff 50%);
    border-color: var(--green-100);
  }

  /* Next */
  .next {
    display: grid;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .next:hover {
    color: inherit;
  }

  .next-title {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
  }

  .next :global(.next-arrow) {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    color: var(--green);
    transition: transform 0.2s var(--ease);
  }

  .next:hover :global(.next-arrow) {
    transform: translateX(4px);
  }
</style>
