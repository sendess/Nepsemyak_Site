---
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import SectionList from '~/components/sections/SectionList.astro';
import type { Section } from '~/lib/pages';
import { useTranslations, type Lang } from '~/i18n/utils';

/** Sections come from the admin panel (Pages → About us), with the original text as the default. */
type Props = { lang: Lang; sections: Section[] };
const { lang, sections } = Astro.props;
const t = useTranslations(lang);
---

<PageHero lang={lang} title={t('about.title')} lead={t('about.intro')} />

<SectionList sections={sections} lang={lang} />

<CtaBand lang={lang} />
