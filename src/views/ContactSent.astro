---
import Icon from '~/components/Icon.astro';
import BranchCard from '~/components/BranchCard.astro';
import { branches } from '~/data/site';
import { localizePath, useTranslations, type Lang } from '~/i18n/utils';

/** `reference` is the code to quote when following up; absent if the page is opened directly. */
type Props = { lang: Lang; reference?: string | null };
const { lang, reference = null } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section-tint">
  <div class="container-narrow done">
    <span class="check"><Icon name="circle-check" size={48} /></span>
    <h1 class="h2">{t('contact.sentTitle')}</h1>
    <p class="lead">{t('contact.sentText')}</p>
    {
      reference && (
        <div class="reference">
          <span class="ref-label">{t('contact.refLabel')}</span>
          <strong class="ref-code">{reference}</strong>
          <span class="small muted">{t('contact.refHelp')}</span>
          <a class="small" href={`${localizePath('/track/', lang)}?ref=${reference}`}>{t('contact.trackThis')}</a>
        </div>
      )
    }
    <p class="muted">{t('contact.sentNext')}</p>
    <a class="btn btn-primary" href={localizePath('/', lang)}>
      <Icon name="arrow-left" size={18} />
      {t('cta.backHome')}
    </a>
  </div>
</section>

<section class="section section-white">
  <div class="container">
    <h2 class="h3" style="margin-bottom: 1.5rem">{t('contact.officesTitle')}</h2>
    <div class="offices">
      {branches.map((b) => <BranchCard branch={b} lang={lang} />)}
    </div>
  </div>
</section>

<style>
  .done {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    text-align: center;
  }

  .reference {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    padding: 1.1rem 1.5rem;
    border: 2px dashed var(--green-200);
    border-radius: var(--radius);
    background: #fff;
  }

  .ref-label {
    font-weight: 600;
    color: var(--muted);
  }

  .ref-code {
    font-family: var(--font-head);
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    letter-spacing: 0.12em;
    color: var(--green-800);
  }

  .check {
    display: grid;
    place-items: center;
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    box-shadow: 0 0 0 14px var(--green-100);
  }

  .offices {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
</style>
