---
import Icon from '~/components/Icon.astro';
import PageHero from '~/components/PageHero.astro';
import LazyEmbed from '~/components/LazyEmbed.astro';
import NewsCard from '~/components/NewsCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import { newsFeeds, facebookPluginUrl } from '~/data/news';
import type { NewsPost } from '~/lib/content';
import { useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang; posts: NewsPost[] };
const { lang, posts } = Astro.props;
const t = useTranslations(lang);
---

<PageHero lang={lang} title={t('news.title')} lead={t('news.latestIntro')} />

{
  posts.length > 0 && (
    <section class="section section-white" aria-label={t('news.latestTitle')}>
      <div class="container">
        <div class="posts">
          {posts.map((post, i) => (
            <NewsCard post={post} lang={lang} featured={i === 0 && posts.length > 2} />
          ))}
        </div>
      </div>
    </section>
  )
}

<section class:list={['section', posts.length > 0 ? 'section-tint' : 'section-white']} aria-labelledby="fb-title">
  <div class="container">
    <div class="fb-head">
      <h2 class="h3" id="fb-title">{t('news.fromFacebook')}</h2>
    </div>
    <div class="feeds">
      {
        newsFeeds
          .filter((feed) => feed.embed)
          .map((feed) => (
            <article class="feed reveal">
              <header>
                <span class="icon-tile solid">
                  <Icon name="facebook" size={20} />
                </span>
                <h3 class="h4">{feed.name[lang]}</h3>
                <a class="link-arrow" href={feed.pageUrl} target="_blank" rel="noopener" aria-label={`${feed.name[lang]} — ${t('common.facebook')} ${t('common.opensNewTab')}`}>
                  <Icon name="external-link" size={16} />
                </a>
              </header>
              <div class="frame">
                <LazyEmbed src={facebookPluginUrl(feed.pageUrl)} title={`${feed.name[lang]} — Facebook`} icon="facebook" height="720px" />
              </div>
            </article>
          ))
      }
    </div>
    <div class="fb-links">
      <p class="muted">{t('news.fbTrouble')}</p>
      <ul>
        {
          newsFeeds.map((feed) => (
            <li>
              <a class="btn btn-ghost btn-sm" href={feed.pageUrl} target="_blank" rel="noopener">
                <Icon name="facebook" size={16} />
                {feed.name[lang]}
                <span class="visually-hidden">{t('common.opensNewTab')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<CtaBand lang={lang} />

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }

  .fb-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .feeds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
  }

  .feed {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  /* The Facebook plugin is at most 500px wide; centre it in wider cards. */
  .frame {
    width: 100%;
    max-width: 500px;
    margin-inline: auto;
  }

  .fb-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .fb-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feed header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.25rem 0.25rem 0;
  }
</style>
