---
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import SectionList from '~/components/sections/SectionList.astro';
import type { Section } from '~/lib/pages';
import { useTranslations, type Lang } from '~/i18n/utils';

/** Sections come from the admin panel (Pages → Our team), with the original list as the default. */
type Props = { lang: Lang; sections: Section[] };
const { lang, sections } = Astro.props;
const t = useTranslations(lang);
---

<PageHero lang={lang} title={t('team.title')} lead={t('team.intro')} parent={{ path: '/about', label: t('nav.about') }} />

<SectionList sections={sections} lang={lang} />

<CtaBand lang={lang} flush />
