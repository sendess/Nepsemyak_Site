---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import { team } from '~/data/team';
import { telHref, useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<PageHero lang={lang} title={t('team.title')} lead={t('team.intro')} parent={{ path: '/about', label: t('nav.about') }} />

<section class="section section-white">
  <div class="container">
    <ul class="team" role="list">
      {
        team.map((m, i) => (
          <li class:list={['member', 'reveal', { lead: i === 0 }]}>
            <div class="photo">
              <Image src={m.photo} alt={m.name[lang]} width={420} widths={[280, 420]} sizes="(max-width: 600px) 90vw, 280px" />
            </div>
            <div class="info">
              <h2 class="h4">{m.name[lang]}</h2>
              <p class="role">{m.role[lang]}</p>
              <a class="phone" href={telHref(m.phone)}>
                <Icon name="phone" size={16} />
                {m.phone}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<CtaBand lang={lang} flush />

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .member:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .photo {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--green-700);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .member:hover .photo :global(img) {
    transform: scale(1.04);
  }

  .lead .photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 5px;
    background: linear-gradient(to right, var(--green-bright), var(--yellow));
  }

  .info {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .role {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
</style>
